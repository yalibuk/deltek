# yönlendirme olmadan 404 veriyordu. Kaynak JPEG/PNG'ler bu yüzden WebP'ye
# çevrildikten sonra da yerinde bırakıldı; hedef dosya var.
/wp-content/uploads/*   /images/uploads/:splat   301
