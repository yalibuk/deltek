# Cloudflare Pages yönlendirmeleri
# Kural: deltek.com.tr'deki mevcut slug'lar birebir korunur. Bir slug
# değişmek zorunda kalırsa buraya 301 olarak eklenir ve CLAUDE.md'deki
# tabloya işlenir.

# WordPress tarih arşivleri yeni sitede yok -> blog listesine
/2017/*   /blog/   301
/2026/*   /blog/   301

# Boru Sürme, Boru Çakma sayfası kaldırıldı (Boru Sürme/Çakma ile aynı konu)
/boru-surme-boru-cakma-auger-boring/   /boru-surmecakma/   301

# Kaldırılan sayfalar -> aynı konuyu anlatan sayfa
# "Yatay Sondaj Kazısız Yatay Delgi" HDD Nedir? ile aynı konuyu anlatıyordu.
/yatay-sondaj-kazisiz-yatay-delgi/        /yonlendirilebilir-yatay-sondaj-nedir/   301
# "Kazısız Altyapı ve Kazısız Teknolojiler" bölümün genel bakış sayfasıydı.
/kazisiz-altyapi-ve-kazisiz-teknolojiler/ /yatay-sondaj-teknoloji/                 301

# Auger Boring ve Mikrotünel ayrı sayfa olmaktan çıktı; ikisi de artık
# Boru Sürme/Çakma sayfasında başlıklı birer bölüm.
/auger-boring-nedir-modern-yatay-delgi-teknolojisi/ /boru-surmecakma/  301
/mikrotunel-nedir/                                  /boru-surmecakma/  301

# Medyalar sayfası kaldırıldı; içindeki tek video blog yazısı oldu.
/medyalar/   /deltek-yatay-sondaj-kaya-delgi-rock-drilling/   301

# WordPress artıkları
/feed/          /blog/   301
/wp-login.php   /        301

# Eski WordPress medya adresleri. Taşıma betiği görselleri
# wp-content/uploads/<yol> -> /images/uploads/<yol> olarak indirdi
# (scripts/wp-tasi.mjs), yani canlı sitede indekslenmiş görsel adresleri
# yönlendirme olmadan 404 veriyordu. Kaynak JPEG/PNG'ler bu yüzden WebP'ye
# çevrildikten sonra da yerinde bırakıldı; hedef dosya var.
/wp-content/uploads/*   /images/uploads/:splat   301

