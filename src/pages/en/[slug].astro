---
import Layout from '../../layouts/Layout.astro';
import { SITE } from '../../data/site';
import { kokIcerik, cevirisiVarMi } from '../../data/icerik';
import { render } from 'astro:content';
import UrunDuzen from '../../components/UrunDuzen.astro';
import IletisimDuzen from '../../components/IletisimDuzen.astro';

/**
 * Kök dizindeki her şey buradan üretilir: /<slug>/
 *  - blog yazıları  (src/content/blog/tr/<slug>.md)
 *  - kurumsal/teknoloji sayfaları (src/content/sayfalar/tr/<slug>.md)
 *
 * Canlı deltek.com.tr'de de ikisi de kök dizinde; /blog/ yalnızca liste sayfası.
 * İki koleksiyon aynı slug'ı kullanırsa kokIcerik() build'i hatayla durdurur.
 */
export async function getStaticPaths() {
  const kayitlar = await kokIcerik('en');
  return kayitlar.map(k => ({ params: { slug: k.slug }, props: k }));
}

const { tur, entry, slug } = Astro.props;
const p = entry.data as any;
const { Content } = await render(entry as any);
const cevirisiVar = await cevirisiVarMi(slug, 'tr');

const tarihFmt = (d: any) =>
  d ? new Date(d).toLocaleDateString('en-GB', { day: '2-digit', month: 'long', year: 'numeric' }) : '';

function ytEmbed(url: string | undefined) {
  if (!url) return null;
  const m = url.match(/(?:youtu\.be\/|youtube\.com\/(?:watch\?v=|embed\/|shorts\/))([\w-]{11})/);
  return m ? `https://www.youtube.com/embed/${m[1]}` : null;
}
const embed = ytEmbed(p.video);

const sema = tur === 'yazi'
  ? {
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: p.baslik,
      ...(p.ozet ? { description: p.ozet } : {}),
      ...(p.tarih ? { datePublished: new Date(p.tarih).toISOString().slice(0, 10) } : {}),
      ...(p.kapak ? { image: SITE.kanonikal + p.kapak } : {}),
      mainEntityOfPage: `${SITE.kanonikal}/en/${slug}/`,
      publisher: { '@type': 'Organization', name: SITE.isim },
      inLanguage: 'en',
    }
  : {
      '@context': 'https://schema.org',
      '@type': 'WebPage',
      name: p.baslik,
      ...(p.ozet ? { description: p.ozet } : {}),
      url: `${SITE.kanonikal}/en/${slug}/`,
      inLanguage: 'en',
    };
---
<Layout title={`${p.baslik} — ${SITE.isim}`} description={p.ozet || p.baslik}
        image={p.kapak} sema={sema} cevirisiVar={cevirisiVar}>
{p.duzen === 'iletisim' ? (
  <IletisimDuzen dil="en" baslik={p.baslik} ozet={p.ozet} harita={p.harita}>
    <Content />
  </IletisimDuzen>
) : (
<article class="kap yazi">
  {tur === 'yazi' && <a class="yazi__geri" href="/en/blog/">← Blog</a>}

  <header class="yazi__bas">
    {tur === 'yazi' && p.tarih && <span class="yazi__tarih">{tarihFmt(p.tarih)}</span>}
    <h1>{p.baslik}</h1>
  </header>

  {p.kapak && (
    <figure class="yazi__kapak"><img src={p.kapak} alt={p.baslik} /></figure>
  )}

  {embed && (
    <div class="yazi__video">
      <iframe src={embed} title={p.baslik} loading="lazy"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen></iframe>
    </div>
  )}

  {p.duzen === 'urun' ? (
    <UrunDuzen banner={p.banner} bannerAlt={p.baslik} bloklar={p.bloklar}
               tablolar={p.tablolar} galeri={p.galeri}>
      <div class="yazi__icerik"><Content /></div>
    </UrunDuzen>
  ) : (
    <div class={`yazi__icerik${p.duzen ? " yazi__icerik--" + p.duzen : ""}`}>
      <Content />
    </div>
  )}

  {p.galeri && p.galeri.length > 0 && (
    <div class="yazi__galeri">
      {p.galeri.map((g: any) => g.foto && (
        <figure><img src={g.foto} alt={p.baslik} loading="lazy" /></figure>
      ))}
    </div>
  )}

  <div class="yazi__cta">
    <p>{tur === 'yazi' ? 'Get in touch about your project.' : 'Talk to us about this.'}</p>
    <a class="btn btn--dolu" href={`tel:${SITE.telefonHam}`}>{SITE.telefon}</a>
  </div>
</article>
)}

<style>
.yazi { max-width: 820px; padding-block: clamp(1.5rem,4vw,2.5rem) clamp(3rem,6vw,5rem); }
.yazi__geri { display: inline-block; font-family: var(--f-veri); font-size: .8rem; color: var(--mavi); margin-bottom: 1.4rem; }
.yazi__geri:hover { color: var(--mavi-900); }
.yazi__bas { margin-bottom: 1.6rem; }
.yazi__tarih { font-family: var(--f-veri); font-size: .72rem; letter-spacing: .12em; text-transform: uppercase; color: var(--mavi); }
.yazi__bas h1 { font-family: var(--f-dis); font-weight: 900; font-size: clamp(1.7rem,4vw,2.6rem); letter-spacing: -.025em; line-height: 1.05; color: var(--mavi-900); margin-top: .5rem; text-wrap: balance; }
.yazi__kapak { margin: 0 0 1.8rem; border-radius: 6px; overflow: hidden; border: 1px solid var(--cizgi); }
.yazi__kapak img { width: 100%; height: auto; display: block; }
.yazi__video { position: relative; aspect-ratio: 16/9; margin-bottom: 1.8rem; border-radius: 6px; overflow: hidden; border: 1px solid var(--cizgi); background: var(--blue-950); }
.yazi__video iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
.yazi__icerik { font-size: 1.05rem; line-height: 1.75; color: var(--metin); }
.yazi__icerik :global(p) { margin-bottom: 1.1rem; }
.yazi__icerik :global(h2) { font-family: var(--f-dis); font-weight: 800; font-size: 1.5rem; color: var(--mavi-900); margin: 2rem 0 .8rem; }
.yazi__icerik :global(h3) { font-family: var(--f-dis); font-weight: 700; font-size: 1.2rem; color: var(--mavi-900); margin: 1.5rem 0 .6rem; }
.yazi__icerik :global(h4) { font-family: var(--f-dis); font-weight: 700; font-size: 1.05rem; color: var(--mavi-700); margin: 1.2rem 0 .5rem; }
.yazi__icerik :global(ul), .yazi__icerik :global(ol) { margin: 0 0 1.1rem 1.4rem; }
.yazi__icerik :global(li) { margin-bottom: .4rem; }
.yazi__icerik :global(img) { max-width: 100%; border-radius: 6px; margin: 1rem 0; }
.yazi__icerik :global(a) { color: var(--mavi); text-decoration: underline; }
.yazi__icerik :global(table) { width: 100%; border-collapse: collapse; margin: 1.6rem 0; font-size: .95rem; }
.yazi__icerik :global(th), .yazi__icerik :global(td) { border: 1px solid var(--cizgi); padding: .6rem .8rem; text-align: left; vertical-align: top; }
.yazi__icerik :global(thead th) { background: var(--mavi-050); color: var(--mavi-900); font-family: var(--f-dis); font-weight: 700; }
.yazi__icerik :global(tbody tr:nth-child(even)) { background: var(--kagit); }
/* dar ekranda tablo kendi içinde yatay kaysın, sayfayı taşırmasın */
@media (max-width: 620px) { .yazi__icerik :global(table) { display: block; overflow-x: auto; } }
/* WordPress'ten taşınan video/harita gömüleri */
.yazi__icerik :global(.gomu) { position: relative; aspect-ratio: 16/9; margin: 1.6rem 0; border-radius: 6px; overflow: hidden; border: 1px solid var(--cizgi); background: var(--kagit-2); }
.yazi__icerik :global(.gomu iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
.yazi__icerik :global(figure) { margin: 1.4rem 0; }
.yazi__icerik :global(hr) { border: none; border-top: 1px solid var(--cizgi); margin: 2rem 0; }
/* Logo ızgarası: art arda gelen görsel-tek paragrafları yan yana dizer */
.yazi__icerik--logo-izgara { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 1.6rem 2.4rem; }
.yazi__icerik--logo-izgara :global(p) { margin: 0; }
.yazi__icerik--logo-izgara :global(img) { margin: 0; max-height: 72px; width: auto; border-radius: 0; filter: grayscale(1); opacity: .72; transition: filter .2s, opacity .2s; }
.yazi__icerik--logo-izgara :global(img:hover) { filter: none; opacity: 1; }
.yazi__galeri { display: grid; grid-template-columns: repeat(2, 1fr); gap: .8rem; margin-top: 2rem; }
@media (min-width: 640px) { .yazi__galeri { grid-template-columns: repeat(3, 1fr); } }
.yazi__galeri figure { margin: 0; border-radius: 4px; overflow: hidden; border: 1px solid var(--cizgi); aspect-ratio: 4/3; }
.yazi__galeri img { width: 100%; height: 100%; object-fit: cover; transition: transform .3s; }
.yazi__galeri figure:hover img { transform: scale(1.05); }
.yazi__cta { margin-top: 2.8rem; padding: 1.8rem; background: var(--mavi-050); border: 1px solid var(--cizgi); border-radius: 6px; text-align: center; }
.yazi__cta p { font-family: var(--f-dis); font-weight: 700; color: var(--mavi-900); margin-bottom: 1rem; }
</style>
</Layout>
