---
import Layout from '../../layouts/Layout.astro';
import { SITE, OFISLER, yolTarifi } from '../../data/site';
import { CEVIRI } from '../../data/i18n';
import { kokIcerik, karsiSlug, sayfaSlugu, ilgiliSayfalar } from '../../data/icerik';
import { render } from 'astro:content';
import UrunDuzen from '../../components/UrunDuzen.astro';
import LogoSerit from '../../components/LogoSerit.astro';
import IletisimDuzen from '../../components/IletisimDuzen.astro';
import HizmetDuzen from '../../components/HizmetDuzen.astro';
import TeknolojiHaritasi from '../../components/TeknolojiHaritasi.astro';
import { teknolojiAgaci, teknolojiKomsulari } from '../../data/icerik';
import TeknolojiGezinme from '../../components/TeknolojiGezinme.astro';
import TeknolojiYanMenu from '../../components/TeknolojiYanMenu.astro';
import SayfaBanner from '../../components/SayfaBanner.astro';
import IlgiliSayfalar from '../../components/IlgiliSayfalar.astro';
import { gorselOznitelik } from '../../data/gorselOlcu';
import { TEKNOLOJI_KOK } from '../../data/teknoloji';

/**
 * Kök dizindeki her şey buradan üretilir: /<slug>/
 *  - blog yazıları  (src/content/blog/tr/<slug>.md)
 *  - kurumsal/teknoloji sayfaları (src/content/sayfalar/tr/<slug>.md)
 *
 * Canlı deltek.com.tr'de de ikisi de kök dizinde; /blog/ yalnızca liste sayfası.
 * İki koleksiyon aynı slug'ı kullanırsa kokIcerik() build'i hatayla durdurur.
 *
 * TR aslı `[slug].astro` — bu dosya ondan türetilmiştir (dil='en', '/en' öneki,
 * en-GB tarih biçimi). TR'de yapılan bir değişiklik buraya da işlenmeli.
 */
export async function getStaticPaths() {
  const kayitlar = await kokIcerik('en');
  return kayitlar.map(k => ({ params: { slug: k.slug }, props: k }));
}

const dil = 'en' as const;
const t = CEVIRI[dil];
const yol = (p: string) => '/en' + p;               // EN /en/ altında
const { tur, entry, slug, anahtar } = Astro.props;   // slug = URL, anahtar = dosya adı
const p = entry.data as any;
const { Content } = await render(entry as any);
// Diğer dildeki karşılık: URL slug'ı dilden dile değişir (EN adresler İngilizce),
// eşleşme dosya adıyla (anahtar) yapılır. Yoksa hreflang basılmaz.
const karsi = await karsiSlug(anahtar, 'tr');
const cevirisiVar = karsi !== null;
const karsiYol = karsi ? `/${karsi}/` : undefined;
const tekKok = await sayfaSlugu(dil, TEKNOLOJI_KOK);   // bölüm kökünün bu dildeki URL'si
// Bölüm haritası yalnızca istendiğinde hesaplanır (ağaç build'de doğrulanır).
const tekAgac = p.bolumHaritasi ? await teknolojiAgaci(dil) : null;
// Sayfa teknoloji ağacında mı? Yan menü ve sayfa altı gezinme buna bağlı.
const agacta = tur === 'sayfa' ? await teknolojiKomsulari(dil, anahtar) : null;
// Yan menü canlı sitedeki gibi bölümün TÜM sayfalarında görünür; kök sayfa
// ağaçta olmadığı için `yanMenu: true` ile ayrıca işaretlenir.
const yanAgac = (p.yanMenu || agacta) ? (tekAgac ?? await teknolojiAgaci(dil)) : null;
// Kök sayfada altta gezinme yok — orada zaten haritanın tamamı var.
const tekKomsu = p.bolumHaritasi ? null : agacta;
// "İlgili sayfalar" — frontmatter'daki slug listesi (iç bağlantı).
const ilgili = p.ilgili?.length ? await ilgiliSayfalar(dil, p.ilgili) : [];

// Başlık banner'ı: başlık görselin içine gömülü değil, gerçek <h1> olarak
// sembolün yanında durur. Varsa sayfanın ayrı <h1>'i ve UrunDuzen'in düz
// banner'ı basılmaz — ikisi de aynı başlığı tekrar ederdi.
const bannerSembol: string | undefined = p.bannerSembol;
// Etiket: ağaçtaki üst dalın adı; kök seviyedeki sayfalarda bölümün adı.
// Başlık zaten üst dalın adıyla başlıyorsa (ör. üst dal "Yönlendirilebilir
// Yatay Sondaj", başlık "Yönlendirilebilir Yatay Sondaj Yapım Metodu")
// etiket basılmaz — giderdiğimiz tekrarın aynısı olurdu.
const kucuk = (m: string) => m.toLocaleLowerCase('en-US');
const ustAd = bannerSembol && agacta ? (agacta.ust?.ad ?? t.tek.kunye) : undefined;
const bannerEtiket = ustAd && !kucuk(p.baslik).includes(kucuk(ustAd)) ? ustAd : undefined;

const tarihFmt = (d: any) =>
  d ? new Date(d).toLocaleDateString('en-GB', { day: '2-digit', month: 'long', year: 'numeric' }) : '';
const isoTarih = (d: any) => d ? new Date(d).toISOString().slice(0, 10) : undefined;

/** YouTube ya da Vimeo bağlantısından gömme adresi. */
function videoEmbed(url: string | undefined) {
  if (!url) return null;
  const yt = url.match(/(?:youtu\.be\/|youtube\.com\/(?:watch\?v=|embed\/|shorts\/))([\w-]{11})/);
  if (yt) return { src: `https://www.youtube.com/embed/${yt[1]}`, sayfa: `https://www.youtube.com/watch?v=${yt[1]}`, kucuk: `https://i.ytimg.com/vi/${yt[1]}/hqdefault.jpg` };
  const vm = url.match(/vimeo\.com\/(?:video\/)?(\d+)/);
  if (vm) return { src: `https://player.vimeo.com/video/${vm[1]}`, sayfa: `https://vimeo.com/${vm[1]}`, kucuk: undefined };
  return null;
}
const embed = videoEmbed(p.video);
const kapakOlcu = p.kapak ? await gorselOznitelik(p.kapak) : {};
const galeriOlcu = await Promise.all(((p.galeri ?? []) as any[]).map((g: any) => g.foto ? gorselOznitelik(g.foto) : Promise.resolve({})));

// <title>/OG başlığı: <h1> kısaltılan sayfalarda (ör. "HDD Nedir?") uzun,
// anahtar kelimeli başlık `seoBaslik`te durur; diğerlerinde ikisi aynı.
const belgeBaslik = p.seoBaslik || p.baslik;
const sayfaUrl = `${SITE.kanonikal}${yol(`/${slug}/`)}`;
const orgId = SITE.kanonikal + '/#organization';
const yayinci = { '@type': 'Organization', '@id': orgId, name: SITE.isim,
  logo: { '@type': 'ImageObject', url: SITE.kanonikal + '/deltek-logo.png' } };

/**
 * Ekmek kırıntısı — Google sonuçlarda yol olarak gösterir.
 *   yazı:            Ana sayfa › Blog › Yazı
 *   teknoloji sayfası: Ana sayfa › Teknoloji › [üst dal] › Sayfa
 *   diğer sayfa:     Ana sayfa › Sayfa
 */
const kirinti: { ad: string; url: string }[] = [{ ad: t.seo.breadcrumbAna, url: SITE.kanonikal + yol('/') }];
if (tur === 'yazi') kirinti.push({ ad: t.nav.blog[0], url: SITE.kanonikal + yol('/blog/') });
else if (agacta || p.bolumHaritasi || p.yanMenu) {
  if (anahtar !== TEKNOLOJI_KOK) kirinti.push({ ad: t.tek.kunye, url: SITE.kanonikal + yol(`/${tekKok}/`) });
  if (agacta?.ust) kirinti.push({ ad: agacta.ust.ad, url: SITE.kanonikal + yol(`/${agacta.ust.slug}/`) });
}
kirinti.push({ ad: p.baslik, url: sayfaUrl });
const kirintiSema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: kirinti.map((k, i) => ({ '@type': 'ListItem', position: i + 1, name: k.ad, item: k.url })),
};

const sayfaSema = tur === 'yazi'
  ? {
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      '@id': sayfaUrl + '#article',
      headline: p.baslik,
      ...(p.ozet ? { description: p.ozet } : {}),
      ...(p.tarih ? { datePublished: isoTarih(p.tarih) } : {}),
      ...(p.guncelleme || p.tarih ? { dateModified: isoTarih(p.guncelleme || p.tarih) } : {}),
      ...(p.kapak ? { image: SITE.kanonikal + p.kapak } : {}),
      ...(p.anahtarKelimeler ? { keywords: p.anahtarKelimeler } : {}),
      mainEntityOfPage: { '@type': 'WebPage', '@id': sayfaUrl },
      author: { '@type': 'Organization', '@id': orgId, name: SITE.isim },
      publisher: yayinci,
      inLanguage: dil,
      isPartOf: { '@type': 'Blog', '@id': SITE.kanonikal + yol('/blog/') + '#blog', name: `${SITE.isim} Blog` },
    }
  : {
      '@context': 'https://schema.org',
      '@type': 'WebPage',
      '@id': sayfaUrl,
      name: belgeBaslik,
      ...(p.ozet ? { description: p.ozet } : {}),
      url: sayfaUrl,
      inLanguage: dil,
      ...(p.kapak || p.banner ? { primaryImageOfPage: { '@type': 'ImageObject', url: SITE.kanonikal + (p.kapak || p.banner) } } : {}),
      ...(p.guncelleme ? { dateModified: isoTarih(p.guncelleme) } : {}),
      isPartOf: { '@type': 'WebSite', '@id': SITE.kanonikal + '/#website' },
      about: { '@id': orgId },
      breadcrumb: { '@id': sayfaUrl + '#breadcrumb' },
    };
// Video gömülü yazı: VideoObject — Google video sonuçları için.
const videoSema = embed ? {
  '@context': 'https://schema.org',
  '@type': 'VideoObject',
  name: p.baslik,
  description: p.ozet || p.baslik,
  ...(p.tarih ? { uploadDate: isoTarih(p.tarih) } : {}),
  thumbnailUrl: p.kapak ? SITE.kanonikal + p.kapak : (embed.kucuk || SITE.kanonikal + '/og-image.jpg'),
  embedUrl: embed.src,
  contentUrl: embed.sayfa,
  publisher: yayinci,
  inLanguage: dil,
} : null;

/**
 * Hizmet şeması — ana sayfadaki ItemList'in sayfa düzeyindeki karşılığı.
 * Dört ana hizmet + hizmetlerimiz; teknik açıklama sayfaları (tij, çamur,
 * yer belirleme…) hizmet DEĞİL, onlara basılmaz.
 */
const HIZMET_SAYFALARI = ['yatay-sondaj', 'boru-surmecakma', 'boru-yenileme', 'akilli-altyapi', 'hizmetlerimiz'];   // anahtar (dosya adı)
const hizmetSema = tur === 'sayfa' && HIZMET_SAYFALARI.includes(anahtar) ? {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': sayfaUrl + '#service',
  name: belgeBaslik,
  serviceType: p.baslik,
  description: p.ozet || p.baslik,
  url: sayfaUrl,
  provider: { '@id': orgId },
  areaServed: { '@type': 'Country', name: 'Türkiye' },
  inLanguage: dil,
} : null;

/**
 * İletişim sayfasında ofis başına LocalBusiness (alt tür GeneralContractor):
 * Google'ın çok şubeli işletme önerisi — Organization site geneli, her şube
 * kendi sayfasında LocalBusiness. Koordinat ve çalışma saati OFISLER'de
 * doluysa basılır (src/data/site.ts).
 */
const ofisSema = p.duzen === 'iletisim' ? OFISLER.map((o, i) => ({
  '@context': 'https://schema.org',
  '@type': ['LocalBusiness', 'GeneralContractor'],
  '@id': sayfaUrl + '#ofis-' + (i + 1),
  name: `${SITE.isim} — ${o.sehir}`,
  parentOrganization: { '@id': orgId },
  url: sayfaUrl,
  telephone: SITE.telefonHam,
  email: SITE.eposta,
  image: SITE.kanonikal + '/og-image.jpg',
  address: { '@type': 'PostalAddress', streetAddress: o.adres, addressLocality: o.sehir,
    postalCode: (o.adres2.match(/\d{5}/) || [''])[0], addressCountry: 'TR' },
  hasMap: yolTarifi(o),
  ...(o.enlem && o.boylam ? { geo: { '@type': 'GeoCoordinates', latitude: o.enlem, longitude: o.boylam } } : {}),
  ...(o.calismaSaatleri?.length ? { openingHoursSpecification: o.calismaSaatleri } : {}),
  areaServed: { '@type': 'Country', name: 'Türkiye' },
})) : [];

/**
 * SSS şeması — gövdede "Sık sorulan sorular" / "Frequently asked questions"
 * başlığı altındaki `**Soru?** Cevap` paragraflarından FAQPage üretir.
 * Google FAQ zengin sonucunu 2023'ten beri yalnız resmi/sağlık sitelerine
 * gösteriyor; şema yine de sayfanın soru-cevap yapısını arama motorlarına ve
 * yapay zekâ özetlerine açıkça anlatıyor. İçerik markdown'da; buradaki
 * çözümleyici yalnız o bölümü okur, başka yerde soru aramaz.
 */
function sssCikar(body: string | undefined) {
  if (!body) return null;
  const bas = body.match(/^##+\s*(?:s[ıi]k(?:[çc]a)?\s+sorulan\s+sorular|frequently\s+asked\s+questions|sss|faq)\s*$/im);
  if (!bas || bas.index === undefined) return null;
  const sonra = body.slice(bas.index + bas[0].length);
  const bitis = sonra.search(/^##+\s/m);
  const bolum = bitis === -1 ? sonra : sonra.slice(0, bitis);
  const duz = (s: string) => s.replace(/\[([^\]]+)\]\([^)]+\)/g, '$1').replace(/\*\*?([^*]+)\*\*?/g, '$1').replace(/\s+/g, ' ').trim();
  const sorular = bolum.split(/\n\s*\n/).map(par => par.match(/^\s*\*\*(.+?)\*\*\s*([\s\S]+)$/))
    .filter((m): m is RegExpMatchArray => !!m)
    .map(m => ({ '@type': 'Question', name: duz(m[1]), acceptedAnswer: { '@type': 'Answer', text: duz(m[2]) } }));
  return sorular.length ? { '@context': 'https://schema.org', '@type': 'FAQPage', '@id': sayfaUrl + '#faq', mainEntity: sorular } : null;
}
const sssSema = sssCikar(entry.body);
const sema = [sayfaSema, { ...kirintiSema, '@id': sayfaUrl + '#breadcrumb' }, ...(videoSema ? [videoSema] : []),
  ...(hizmetSema ? [hizmetSema] : []), ...ofisSema, ...(sssSema ? [sssSema] : [])];
---
<Layout title={`${belgeBaslik} — ${SITE.isim}`} description={p.ozet || p.baslik}
        image={p.kapak} imageAlt={p.kapakAlt || p.baslik} keywords={p.anahtarKelimeler}
        sema={sema} cevirisiVar={cevirisiVar} karsiYol={karsiYol}
        tur={tur === 'yazi' ? 'article' : 'website'}
        yayin={p.tarih ? isoTarih(p.tarih) : undefined}
        guncelleme={(p.guncelleme || p.tarih) ? isoTarih(p.guncelleme || p.tarih) : undefined}>
{p.duzen === 'iletisim' ? (
  <IletisimDuzen dil={dil} baslik={p.baslik} ozet={p.ozet} gorsel={p.gorsel} gorselAlt={p.gorselAlt}>
    <Content />
  </IletisimDuzen>
) : (
<article class:list={['kap', 'yazi', yanAgac && 'yazi--yan', p.duzen === 'hizmet' && 'yazi--genis']}>
  {yanAgac && (
    <aside class="yazi__yan">
      <TeknolojiYanMenu agac={yanAgac} aktif={slug} dil={dil} />
    </aside>
  )}
  <div class="yazi__ana">
  {tur === 'yazi' && <a class="yazi__geri" href={yol('/blog/')}>{t.sayfa.blogGeri}</a>}

  {bannerSembol ? (
    <SayfaBanner baslik={p.baslik} sembol={bannerSembol} etiket={bannerEtiket} alt={p.bannerAlt || `${p.baslik} — Deltek trenchless technology illustration`} />
  ) : (
    <header class="yazi__bas">
      {tur === 'yazi' && p.tarih && <span class="yazi__tarih">{tarihFmt(p.tarih)}</span>}
      <h1>{p.baslik}</h1>
    </header>
  )}

  {p.kapak && (
    <figure class="yazi__kapak"><img src={p.kapak} alt={p.kapakAlt || p.baslik} {...kapakOlcu} fetchpriority="high" decoding="async" /></figure>
  )}

  {embed && (
    <div class="yazi__video">
      <iframe src={embed.src} title={p.baslik} loading="lazy"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen></iframe>
    </div>
  )}

  {p.duzen === 'referanslar' ? (
    <>
      {/* Şerit makale sütununun dışına taşar: logolar sayfanın tamamını kullansın */}
      <LogoSerit />
      <div class="yazi__icerik yazi__icerik--referanslar"><Content /></div>
    </>
  ) : p.duzen === 'hizmet' ? (
    <HizmetDuzen dil={dil} hizmetler={p.hizmetler} neden={p.neden} projeler={p.projeler} alanlar={p.alanlar}>
      <div class="yazi__icerik"><Content /></div>
    </HizmetDuzen>
  ) : p.duzen === 'urun' ? (
    <UrunDuzen banner={bannerSembol ? undefined : p.banner} bannerAlt={p.bannerAlt || p.baslik} sayfaBaslik={p.baslik}
               bloklar={p.bloklar} tablolar={p.tablolar} galeri={p.galeri}>
      <div class="yazi__icerik"><Content /></div>
    </UrunDuzen>
  ) : (
    <div class={`yazi__icerik${p.duzen ? " yazi__icerik--" + p.duzen : ""}`}>
      <Content />
    </div>
  )}

  {p.galeri && p.galeri.length > 0 && p.duzen !== 'urun' && (
    <div class="yazi__galeri">
      {p.galeri.map((g: any, i: number) => g.foto && (
        <figure><img src={g.foto} alt={g.alt || p.baslik} {...galeriOlcu[i]} loading="lazy" decoding="async" /></figure>
      ))}
    </div>
  )}

  {tekAgac && <TeknolojiHaritasi agac={tekAgac} dil={dil} />}
  {tekKomsu && <TeknolojiGezinme komsu={tekKomsu} dil={dil} kokSlug={tekKok} />}
  {ilgili.length > 0 && <IlgiliSayfalar sayfalar={ilgili} dil={dil} />}

  {/* CTA `.yazi__ana`nın İÇİNDE olmak zorunda. Dışarıda bırakılırsa yan
      menülü sayfalarda ızgaranın ÜÇÜNCÜ öğesi olur ve otomatik yerleşim onu
      1. sütun / 2. satıra, yani yan menünün altına atar: 268 px'lik dar bir
      şerit hâline gelir, üstelik yapışkan (`sticky`) menü sayfanın dibinde
      hâlâ orada durduğu için menünün altında kalır. Ölçüldü: buton
      x387-655'te, menü kutusunun tam içinde. */}
  <div class="yazi__cta">
    <p>{tur === 'yazi' ? t.sayfa.ctaYazi : t.sayfa.ctaSayfa}</p>
    <a class="btn btn--dolu" href={`tel:${SITE.telefonHam}`}>{SITE.telefon}</a>
  </div>
  </div>
</article>
)}

<style>
.yazi { max-width: 820px; padding-block: clamp(1.5rem,4vw,2.5rem) clamp(3rem,6vw,5rem); }
/* Yan menülü düzen: sol sütunda ağaç, sağda sayfanın kendisi. `.yazi__ana`
   sarmalayıcı her sayfada var (yan menüsüz sayfalarda düz bir blok, görsel
   etkisi yok) — koşullu açılıp kapanan bir etiket yazmamak için. */
/* Kart ızgaralı düzenler makale genişliğine (820px) sığmıyor: dört sütun
   170px'e iniyor ve kartlar 1000px'i aşıyordu. */
.yazi--yan, .yazi--genis { max-width: 1180px; }
@media (min-width: 900px) {
  .yazi--yan { display: grid; grid-template-columns: 268px minmax(0, 1fr);
    gap: clamp(1.6rem, 3vw, 2.8rem); align-items: start; }
  .yazi__yan { position: sticky; top: calc(var(--baslik-y, 210px) - 40px); }
}
@media (max-width: 899px) { .yazi__yan { margin-bottom: 1.8rem; } }
/* `min-height` + dikey dolgu: kutu .8rem metinle 22 px kalıyordu, WCAG'in
   24 px dokunma sınırının altında. Üstteki boşluk dolgu kadar azaltıldı ki
   başlığın yeri değişmesin. */
.yazi__geri { display: inline-flex; align-items: center; min-height: 26px; padding-block: 2px;
  font-family: var(--f-veri); font-size: .8rem; color: var(--mavi); margin-bottom: 1.2rem; }
.yazi__geri:hover { color: var(--mavi-900); }
.yazi__bas { margin-bottom: 1.6rem; }
.yazi__tarih { font-family: var(--f-veri); font-size: .72rem; letter-spacing: .12em; text-transform: uppercase; color: var(--mavi); }
/* Tarih satırı yoksa h1'in üst boşluğu `.yazi__bas`tan taşıp (margin
   collapse) başlığı yan menüden 8px aşağı kaydırıyordu. Banner'lı sayfalarla
   aynı hizada başlasın diye ilk çocukken sıfırlanır; blog yazılarında h1 ilk
   çocuk değil (üstünde tarih var), orada boşluk korunur. */
.yazi__bas h1:first-child { margin-top: 0; }
.yazi__bas h1 { font-family: var(--f-dis); font-weight: 900; font-size: clamp(1.7rem,4vw,2.6rem); letter-spacing: -.025em; line-height: 1.05; color: var(--mavi-900); margin-top: .5rem; text-wrap: balance; }
.yazi__kapak { margin: 0 0 1.8rem; border-radius: 6px; overflow: hidden; border: 1px solid var(--cizgi); }
.yazi__kapak img { width: 100%; height: auto; display: block; }
.yazi__video { position: relative; aspect-ratio: 16/9; margin-bottom: 1.8rem; border-radius: 6px; overflow: hidden; border: 1px solid var(--cizgi); background: var(--blue-950); }
.yazi__video iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
.yazi__icerik { font-size: 1.05rem; line-height: 1.75; color: var(--metin); }
.yazi__icerik :global(p) { margin-bottom: 1.1rem; }
.yazi__icerik :global(h2) { font-family: var(--f-dis); font-weight: 800; font-size: 1.5rem; color: var(--mavi-900); margin: 2rem 0 .8rem; }
.yazi__icerik :global(h3) { font-family: var(--f-dis); font-weight: 700; font-size: 1.2rem; color: var(--mavi-900); margin: 1.5rem 0 .6rem; }
.yazi__icerik :global(h4) { font-family: var(--f-dis); font-weight: 700; font-size: 1.05rem; color: var(--mavi-700); margin: 1.2rem 0 .5rem; }
.yazi__icerik :global(ul), .yazi__icerik :global(ol) { margin: 0 0 1.1rem 1.4rem; }
.yazi__icerik :global(li) { margin-bottom: .4rem; }
