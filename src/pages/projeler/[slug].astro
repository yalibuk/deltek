---
import Layout from '../../layouts/Layout.astro';
import { SITE } from '../../data/site';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const girdiler = await getCollection('projeler');
  return girdiler.map(p => {
    const slug = (p.data.slug && p.data.slug.trim()) ? p.data.slug.trim() : p.id;
    return { params: { slug }, props: { entry: p } };
  });
}

const { entry } = Astro.props;
const p = entry.data;
const { Content } = await render(entry);

const tarihFmt = (d: any) =>
  d ? new Date(d).toLocaleDateString('tr-TR', { day: '2-digit', month: 'long', year: 'numeric' }) : '';

// YouTube linkinden gömme (embed) adresi üret
function ytEmbed(url: string | undefined) {
  if (!url) return null;
  const m = url.match(/(?:youtu\.be\/|youtube\.com\/(?:watch\?v=|embed\/|shorts\/))([\w-]{11})/);
  return m ? `https://www.youtube.com/embed/${m[1]}` : null;
}
const embed = ytEmbed(p.video);
---
<Layout title={`${p.baslik} — ${SITE.isim}`} description={p.ozet || p.baslik}>
<article class="kap proje">
  <a class="proje__geri" href="/projeler">← Sahadan / Projeler</a>

  <header class="proje__bas">
    {p.tarih && <span class="proje__tarih">{tarihFmt(p.tarih)}</span>}
    <h1>{p.baslik}</h1>
    <div class="proje__meta">
      {p.makine && <span>{p.makine}</span>}
      {p.konum && <span>{p.konum}</span>}
    </div>
  </header>

  {p.kapak && (
    <figure class="proje__kapak"><img src={p.kapak} alt={p.baslik} /></figure>
  )}

  {embed && (
    <div class="proje__video">
      <iframe src={embed} title={p.baslik} loading="lazy"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen></iframe>
    </div>
  )}

  <div class="proje__icerik">
    <Content />
  </div>

  {p.galeri && p.galeri.length > 0 && (
    <div class="proje__galeri">
      {p.galeri.map((g: any) => g.foto && (
        <figure><img src={g.foto} alt={p.baslik} loading="lazy" /></figure>
      ))}
    </div>
  )}

  <div class="proje__cta">
    <p>Benzer bir proje mi planlıyorsunuz?</p>
    <a class="btn btn--dolu" href={`tel:${SITE.telefonHam}`}>Bize ulaşın — {SITE.telefon}</a>
  </div>
</article>

<style>
.proje { max-width: 820px; padding-block: clamp(1.5rem,4vw,2.5rem) clamp(3rem,6vw,5rem); }
.proje__geri { display: inline-block; font-family: var(--f-veri); font-size: .8rem; color: var(--mavi); margin-bottom: 1.4rem; }
.proje__geri:hover { color: var(--mavi-900); }
.proje__bas { margin-bottom: 1.6rem; }
.proje__tarih { font-family: var(--f-veri); font-size: .72rem; letter-spacing: .12em; text-transform: uppercase; color: var(--mavi); }
.proje__bas h1 { font-family: var(--f-dis); font-weight: 900; font-size: clamp(1.7rem,4vw,2.6rem); letter-spacing: -.025em; line-height: 1.05; color: var(--mavi-900); margin-top: .5rem; text-wrap: balance; }
.proje__meta { margin-top: .9rem; display: flex; flex-wrap: wrap; gap: .5rem; }
.proje__meta span { font-family: var(--f-veri); font-size: .66rem; letter-spacing: .06em; text-transform: uppercase; color: var(--mute); background: var(--mavi-050); border: 1px solid var(--cizgi); padding: .3rem .6rem; border-radius: 2px; }
.proje__kapak { margin: 0 0 1.8rem; border-radius: 6px; overflow: hidden; border: 1px solid var(--cizgi); }
.proje__kapak img { width: 100%; height: auto; display: block; }
.proje__video { position: relative; aspect-ratio: 16/9; margin-bottom: 1.8rem; border-radius: 6px; overflow: hidden; border: 1px solid var(--cizgi); background: #000; }
.proje__video iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
.proje__icerik { font-size: 1.05rem; line-height: 1.75; color: var(--metin); }
.proje__icerik :global(p) { margin-bottom: 1.1rem; }
.proje__icerik :global(h2) { font-family: var(--f-dis); font-weight: 800; font-size: 1.5rem; color: var(--mavi-900); margin: 2rem 0 .8rem; }
.proje__icerik :global(h3) { font-family: var(--f-dis); font-weight: 700; font-size: 1.2rem; color: var(--mavi-900); margin: 1.5rem 0 .6rem; }
.proje__icerik :global(ul), .proje__icerik :global(ol) { margin: 0 0 1.1rem 1.4rem; }
.proje__icerik :global(li) { margin-bottom: .4rem; }
.proje__icerik :global(img) { max-width: 100%; border-radius: 6px; margin: 1rem 0; }
.proje__icerik :global(a) { color: var(--mavi); text-decoration: underline; }
.proje__galeri { display: grid; grid-template-columns: repeat(2, 1fr); gap: .8rem; margin-top: 2rem; }
@media (min-width: 640px) { .proje__galeri { grid-template-columns: repeat(3, 1fr); } }
.proje__galeri figure { margin: 0; border-radius: 4px; overflow: hidden; border: 1px solid var(--cizgi); aspect-ratio: 4/3; }
.proje__galeri img { width: 100%; height: 100%; object-fit: cover; transition: transform .3s; }
.proje__galeri figure:hover img { transform: scale(1.05); }
.proje__cta { margin-top: 2.8rem; padding: 1.8rem; background: var(--mavi-050); border: 1px solid var(--cizgi); border-radius: 6px; text-align: center; }
.proje__cta p { font-family: var(--f-dis); font-weight: 700; color: var(--mavi-900); margin-bottom: 1rem; }
</style>
</Layout>
