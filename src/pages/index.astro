---
import Layout from '../layouts/Layout.astro';
import { SITE } from '../data/site';
import HeroSlider from '../components/HeroSlider.astro';
import { HERO_TR } from '../data/hero';
import { yazilar } from '../data/icerik';
import { ikonCiz } from '../data/ikon';


// Ana sayfa hizmet kartları ve rakamlar — canlı deltek.com.tr ana
// sayfasından taşındı (metinler kısaltıldı, rakamlar birebir).
const HIZMETLER = [
  { ikon: 'sondaj', ad: 'Yönlendirilebilir Yatay Sondaj', kisa: 'HDD',
    href: '/yonlendirilebilir-yatay-sondaj/',
    metin: 'Doğalgaz, içme suyu, kanalizasyon, elektrik ve fiber optik hatları yer altına alıyoruz. GPS güdümleme ve elektronik hedefleme sistemleri sayesinde güzergâh milimetrik hassasiyetle takip edilir.' },
  { ikon: 'boru', ad: 'Boru Sürme / Çakma', kisa: 'Auger Boring',
    href: '/boru-surmecakma/',
    metin: 'Büyük çaplı çelik boruların yer altına alınmasında kullanılan yöntem. Boru itme, auger boring ve mikrotünel uygulamalarıyla maliyet ve zaman tasarrufu sağlar.' },
  { ikon: 'yenileme', ad: 'Kazısız Boru Yenileme', kisa: 'Pipe Bursting',
    href: '/boru-yenileme/',
    metin: 'Eski hatların yerine kazı yapılmadan yeni borular döşüyoruz — üstelik isterseniz daha büyük çaplarda.' },
  { ikon: 'akilli', ad: 'Akıllı Altyapı Danışmanlığı', kisa: 'Smart Undergrounding',
    href: '/akilli-altyapi/',
    metin: 'Altyapı planlamasında 20 yılı aşkın deneyim. İnovatif altyapı çözümleriyle hayal dahi edilemeyen projelere hayat geçiriyoruz.' },
];

const RAKAMLAR = [
  { deger: '196.210', birim: 'metre', ad: 'Toplam delgi' },
  { deger: '28.136',  birim: 'saat',  ad: 'Harcanan mesai' },
  { deger: '324',     birim: '',      ad: 'Memnun iş ortağı' },
  { deger: '1.275',   birim: 'ton',   ad: 'Makine parkı kapasitesi' },
];

// Son blog yazıları — en yeni 3 tanesi (varsa)
const sonYazilar = (await yazilar('tr')).slice(0, 3);
const projeTarih = (d: any) =>
  d ? new Date(d).toLocaleDateString('tr-TR', { day: '2-digit', month: 'long', year: 'numeric' }) : '';
---
<Layout
  title={`${SITE.isim} — Yatay Sondaj ve Kazısız Geçiş Teknolojileri`}
  description={"Yönlendirilebilir yatay sondaj (HDD), boru sürme-çakma ve kazısız boru yenileme. 2-2000 mm çaplarda kazısız altyapı çözümleri; İstanbul ve İzmir ofisleri."}>

<!-- ── HERO: SLIDER ─────────────────────────── -->
<section class="hero">
  <div class="hero__grid"></div>
  <div class="hero__ic">
    <HeroSlider slaytlar={HERO_TR} etiket="Deltek yatay sondaj projeleri"
                oncekiEtiket="Önceki görsel" sonrakiEtiket="Sonraki görsel" />
  </div>
</section>

<!-- ── Beyaz ayraç: slider ile mavi şerit iç içe geçmesin ── -->
<div class="hero__ayrac"></div>

<!-- ── HERO BİLGİ ŞERİDİ ──────────────────── -->
<div class="hero__bilgi">
  <div class="kap">
    <span class="rozet"><i></i>Deltek</span>
    <h1>Altyapınızı yer üstüne dokunmadan <em>yer altına alıyoruz.</em></h1>
    <p class="hero__alt">Yönlendirilebilir yatay sondaj (HDD), boru sürme &amp; çakma (auger boring), kazısız boru yenileme ve akıllı altyapı danışmanlığı. 2 mm'den 2000 mm'ye varan çaplarda, İstanbul ve İzmir ofislerimizden Türkiye geneline hizmet veriyoruz.</p>
    <div class="hero__eylem">
      <a class="btn btn--dolu" href={`tel:${SITE.telefonHam}`}>
        <svg viewBox="0 0 16 16" width="15" height="15" fill="currentColor"><path d="M3.6 1.4 5.9 1a.7.7 0 0 1 .78.4l1.06 2.4a.7.7 0 0 1-.2.82l-1.2.98a8.6 8.6 0 0 0 4.06 4.06l.98-1.2a.7.7 0 0 1 .82-.2l2.4 1.06a.7.7 0 0 1 .4.78l-.4 2.3a.7.7 0 0 1-.69.58C6.8 13 3 9.2 3 2.1a.7.7 0 0 1 .6-.7Z"/></svg>
        Hemen ara <small>{SITE.telefon}</small>
      </a>
      <a class="btn btn--cizgi" href="#hakkimizda">Daha fazlası</a>
    </div>
  </div>
</div>

<!-- ── HİZMETLER ──────────────────────────── -->
<section class="bolum kap" id="hizmetler">
  <div class="sahadan__bas">
    <div>
      <span class="kunye">Hizmetler</span>
      <h2>Dört yöntem, tek çatı altında.</h2>
    </div>
    <a class="sahadan__tum" href="/hizmetlerimiz/">Tüm hizmetler →</a>
  </div>
  <div class="hkart__izgara">
    {HIZMETLER.map(h => (
      <a class="hkart" href={h.href}>
        <span class="hkart__i">
          <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor"
               stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"
               aria-hidden="true" set:html={ikonCiz(h.ikon)} />
        </span>
        <h3 class="hkart__ad">{h.ad}</h3>
        <span class="hkart__kisa">{h.kisa}</span>
        <p class="hkart__m">{h.metin}</p>
        <span class="hkart__ok" aria-hidden="true">→</span>
      </a>
    ))}
  </div>
</section>

<!-- ── RAKAMLAR ───────────────────────────── -->
<section class="rakam" aria-label="Deltek rakamlarla">
  <div class="kap rakam__izgara">
    {RAKAMLAR.map(r => (
      <div class="rakam__k">
        <span class="rakam__s">{r.deger}{r.birim && <em>{r.birim}</em>}</span>
        <span class="rakam__a">{r.ad}</span>
      </div>
    ))}
  </div>
</section>

{sonYazilar.length > 0 && (
<section class="bolum kap" id="blog">
  <div class="sahadan__bas">
    <div>
      <span class="kunye">Blog</span>
      <h2>Son yazılar.</h2>
    </div>
    <a class="sahadan__tum" href="/blog/">Tüm yazılar →</a>
  </div>
  <div class="sahadan__grid">
    {sonYazilar.map(({ entry, slug }) => (
      <a class="skart" href={`/${slug}/`}>
        <div class="skart__g">
          {entry.data.kapak
            ? <img src={entry.data.kapak} alt={entry.data.baslik} loading="lazy" />
            : <div class="skart__yok">DELTEK</div>}
          {entry.data.video && <span class="skart__vid" aria-hidden="true">▶</span>}
        </div>
        <div class="skart__b">
          {entry.data.tarih && <span class="skart__tarih">{projeTarih(entry.data.tarih)}</span>}
          <h3>{entry.data.baslik}</h3>
          {entry.data.ozet && <p>{entry.data.ozet}</p>}
        </div>
      </a>
    ))}
  </div>
</section>
)}

<!-- ── HAKKIMIZDA ──────────────────────────── -->
<section class="kanit" id="hakkimizda">
  <div class="kap">
    <div class="kanit__bas">
      <span class="kanit__etiket">Hakkımızda</span>
      <h2>Kazısız altyapıda <em>multidisipliner bir ekip.</em></h2>
      <p>İnşaat ve altyapı sektöründeki tecrübesiyle farklı mühendislik kollarını tek çatı altında birleştiren; gereksiz kapasite kullanımını ve ek maliyetleri ortadan kaldırarak iş ortaklarına sürdürülebilir bir ilişki sunan bir ekibiz.</p>
    </div>
    <div class="kanit__ic">
      <article class="kanit__h">
        <span class="kanit__no">01</span>
        <h4>Mühendisliğin 4E kuralı</h4>
        <p>Tasarladığımız her projede sırasıyla Emniyet, Ekonomi, Estetik ve Evrensellik. Basmakalıp iş yapma geleneğinin yerine, her aşaması ölçülebilir bir yol haritası.</p>
      </article>
      <article class="kanit__h">
        <span class="kanit__no">02</span>
        <h4>Akıllı altyapı yaklaşımı</h4>
        <p>“Smart Undergrounding” kavramını literatüre kazandıran mühendislerimiz, her hat için en makul ve en tasarruflu çözümü daha işe başlamadan hesaplıyor.</p>
      </article>
      <article class="kanit__h">
        <span class="kanit__no">03</span>
        <h4>Her ölçeğe yeten makine parkı</h4>
        <p>Yönlendirilebilir yatay sondajda 250 ton, boru sürmede 800 tona varan kapasite. En uygun makine ve ekip seçimi için fizibilite raporunu ücretsiz çıkarıyoruz.</p>
      </article>
    </div>
  </div>
</section>

<!-- ── ÇAĞRI ───────────────────────────────── -->
<section class="kap" id="iletisim" style="padding-block:clamp(2rem,5vw,4rem)">
  <div class="bit-cta">
    <p>Sorularınız için bize ulaşın.</p>
    <a class="btn bit-cta__btn" href={`tel:${SITE.telefonHam}`}>
      <svg viewBox="0 0 16 16" width="15" height="15" fill="currentColor"><path d="M3.6 1.4 5.9 1a.7.7 0 0 1 .78.4l1.06 2.4a.7.7 0 0 1-.2.82l-1.2.98a8.6 8.6 0 0 0 4.06 4.06l.98-1.2a.7.7 0 0 1 .82-.2l2.4 1.06a.7.7 0 0 1 .4.78l-.4 2.3a.7.7 0 0 1-.69.58C6.8 13 3 9.2 3 2.1a.7.7 0 0 1 .6-.7Z"/></svg>
      {SITE.telefon}
    </a>
  </div>
</section>

</Layout>

<script>
(function(){
  const ray = document.getElementById('ray') as HTMLElement;
  const nokta = document.getElementById('nokta') as HTMLElement;
  if (!ray || !nokta) return;
  const n = ray.children.length;
  let i = 0, oto: ReturnType<typeof setInterval> | null = null;
  const azalt = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  for (let k = 0; k < n; k++) {
    const b = document.createElement('button');
    b.setAttribute('role','tab');
    b.setAttribute('aria-label', `${k+1}. görsel`);
    b.onclick = () => { git(k); sifirla(); };
    nokta.appendChild(b);
  }
  function ciz() {
    (ray as HTMLElement).style.transform = `translateX(${-i*100}%)`;
    Array.from(nokta.children).forEach((d,k) => d.setAttribute('aria-current', k===i?'true':'false'));
    // aktif slayt işaretlenince katman görselleri yumuşak biçimde giriyor.
    // inert: ekran dışındaki slaytların butonları klavyeyle odaklanmasın.
    Array.from(ray.children).forEach((s,k) => {
      (s as HTMLElement).setAttribute('data-aktif', k===i?'true':'false');
      (s as HTMLElement).inert = k !== i;
    });
  }
  function git(x: number) { i = (x+n)%n; ciz(); }
  function ileri() { git(i+1); } function geri() { git(i-1); }
  function basla() { if(azalt) return; dur(); oto = setInterval(ileri, 8000); }
  function dur() { if (oto) { clearInterval(oto); oto = null; } }
  function sifirla() { dur(); basla(); }
  (document.getElementById('ileri') as HTMLElement).onclick = () => { ileri(); sifirla(); };
  (document.getElementById('geri') as HTMLElement).onclick = () => { geri(); sifirla(); };
  const sl = document.querySelector('.slider') as HTMLElement;
  sl.addEventListener('mouseenter', dur);
  sl.addEventListener('mouseleave', basla);
  sl.addEventListener('keydown', (e: KeyboardEvent) => {
    if (e.key==='ArrowRight') { ileri(); sifirla(); }
    if (e.key==='ArrowLeft') { geri(); sifirla(); }
  });
  let x0: number | null = null;
  sl.addEventListener('touchstart', (e: TouchEvent) => { x0 = e.touches[0].clientX; dur(); }, {passive:true});
  sl.addEventListener('touchend', (e: TouchEvent) => {
    if (x0===null) return;
    const dx = e.changedTouches[0].clientX - x0;
    if (Math.abs(dx)>40) { dx<0?ileri():geri(); }
    x0=null; basla();
  }, {passive:true});
  ciz(); basla();
})();
</script>
