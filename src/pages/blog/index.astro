---
import Layout from '../../layouts/Layout.astro';
import { SITE } from '../../data/site';
import { yazilar } from '../../data/icerik';
import { gorselOznitelik } from '../../data/gorselOlcu';

// Canlı sitede /blog/ yalnızca liste sayfası; yazıların kendisi kök dizinde.
const liste = await yazilar('tr');
const kapakOlcu = await Promise.all(liste.map(({ entry }) => entry.data.kapak ? gorselOznitelik(entry.data.kapak) : Promise.resolve({})));
const tarihFmt = (d: any) =>
  d ? new Date(d).toLocaleDateString('tr-TR', { day: '2-digit', month: 'long', year: 'numeric' }) : '';
const sema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  '@id': SITE.kanonikal + '/blog/#blog',
  name: `${SITE.isim} Blog — Yatay Sondaj Haberleri`,
  url: SITE.kanonikal + '/blog/',
  inLanguage: 'tr',
  publisher: { '@id': SITE.kanonikal + '/#organization' },
  blogPost: liste.map(({ entry, slug }) => ({ '@type': 'BlogPosting', headline: entry.data.baslik, url: `${SITE.kanonikal}/${slug}/`,
    ...(entry.data.tarih ? { datePublished: new Date(entry.data.tarih).toISOString().slice(0, 10) } : {}) })),
};
---
<Layout title={`Yatay Sondaj Blogu: HDD Haberleri ve Teknik Yazılar — ${SITE.isim}`}
        description="Yönlendirilebilir yatay sondaj (HDD), boru sürme ve kazısız geçiş teknolojileri üzerine teknik yazılar, dünya rekorları ve sektör haberleri. Deltek blog."
        keywords="yatay sondaj blog, HDD haberleri, yönlendirilebilir yatay delgi, kazısız teknoloji haberleri, Deltek"
        sema={sema}>
<section class="kap bolum">
  <span class="kunye">Blog</span>
  <h1>Yatay sondaj yazıları ve haberler.</h1>
  <p style="color:var(--mute);margin-top:.6rem;max-width:62ch">
    Yönlendirilebilir yatay sondaj (HDD), boru sürme, mikrotünel ve kazısız geçiş
    teknolojileri üzerine teknik yazılar; dünyadan rekor kıran HDD projeleri ve sektör haberleri.
  </p>

  {liste.length === 0 ? (
    <div class="pboş">
      <p>Yakında ilk yazılarımızı burada paylaşacağız.</p>
      <a class="btn btn--dolu" href={`tel:${SITE.telefonHam}`}>Bize ulaşın</a>
    </div>
  ) : (
    <div class="pgrid">
      {liste.map(({ entry, slug }, i) => (
        <a class="pkart" href={`/${slug}/`}>
          <div class="pkart__g">
            {entry.data.kapak
              ? <img src={entry.data.kapak} alt={entry.data.kapakAlt || entry.data.baslik} {...kapakOlcu[i]} loading="lazy" decoding="async" />
              : <div class="pkart__yok">DELTEK</div>}
            {entry.data.video && <span class="pkart__vid" aria-hidden="true">▶</span>}
          </div>
          <div class="pkart__b">
            {entry.data.tarih && <span class="pkart__tarih">{tarihFmt(entry.data.tarih)}</span>}
            <h2>{entry.data.baslik}</h2>
            {entry.data.ozet && <p>{entry.data.ozet}</p>}
          </div>
        </a>
      ))}
    </div>
  )}
</section>

<style>
.pgrid { display: grid; gap: 1.4rem; margin-top: 2.4rem; grid-template-columns: 1fr; }
@media (min-width: 640px) { .pgrid { grid-template-columns: repeat(2, 1fr); } }
@media (min-width: 980px) { .pgrid { grid-template-columns: repeat(3, 1fr); } }
.pkart { display: flex; flex-direction: column; border: 1px solid var(--cizgi); border-radius: 4px; overflow: hidden; background: var(--beyaz); box-shadow: 0 14px 34px -26px rgb(var(--blue-800-rgb) / .4); transition: .2s; }
.pkart:hover { border-color: var(--mavi); box-shadow: 0 20px 40px -22px rgb(var(--blue-800-rgb) / .5); transform: translateY(-2px); }
.pkart__g { position: relative; aspect-ratio: 16/10; overflow: hidden; background: var(--kagit-2); }
.pkart__g img { width: 100%; height: 100%; object-fit: cover; transition: transform .4s; }
.pkart:hover .pkart__g img { transform: scale(1.05); }
.pkart__yok { width: 100%; height: 100%; display: grid; place-items: center; font-family: var(--f-dis); font-weight: 800; color: var(--blue-600); letter-spacing: .1em; }
.pkart__vid { position: absolute; inset: 0; margin: auto; width: 54px; height: 54px; display: grid; place-items: center; background: rgb(var(--blue-800-rgb) / .72); color: var(--beyaz); border-radius: 50%; font-size: 1.1rem; padding-left: 4px; }
.pkart__b { padding: 1.1rem 1.2rem 1.3rem; display: flex; flex-direction: column; gap: .4rem; flex: 1; }
.pkart__tarih { font-family: var(--f-veri); font-size: .68rem; letter-spacing: .1em; text-transform: uppercase; color: var(--mavi); }
.pkart__b h2 { font-family: var(--f-dis); font-weight: 800; font-size: 1.15rem; color: var(--mavi-900); letter-spacing: -.01em; }
.pkart__b p { color: var(--mute); font-size: .9rem; }
.pboş { margin-top: 2.5rem; padding: 3rem 1.5rem; text-align: center; background: var(--kagit); border: 1px dashed var(--cizgi-2); border-radius: 6px; }
.pboş p { color: var(--mute); margin-bottom: 1.2rem; }
</style>
</Layout>
