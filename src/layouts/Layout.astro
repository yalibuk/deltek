---
import '../styles/global.css';
import { SITE, KATEGORILER, KBAR } from '../data/site';
import { CEVIRI, KATEGORI_EN } from '../data/i18n';
import { menuSayfalari } from '../data/icerik';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  keywords?: string;
  sema?: any;
  /**
   * Bu sayfanın diğer dilde bir karşılığı var mı?
   * false ise hreflang alternatifi basılmaz ve dil düğmesi o dilin
   * ana sayfasına gider. Çevirisi olmayan blog yazıları için kullanılır.
   */
  cevirisiVar?: boolean;
}
const { title = SITE.isim, description = '', image, keywords, sema, cevirisiVar = true } = Astro.props;
// trailingSlash: 'always' — tüm iç yollar eğik çizgiyle biter.
const pathname = Astro.url.pathname;
const dil = pathname.startsWith('/en/') ? 'en' : 'tr';
const t = CEVIRI[dil];
const yol = (p: string) => dil === 'en' ? ('/en' + (p === '/' ? '/' : p)) : p;
const kategoriAdi = (k: any) => dil === 'en' ? (KATEGORI_EN[k.slug] || k.ad) : k.ad;
const kbarAd = (k: any) => dil === 'en' ? (KATEGORI_EN[k.anahtar] || k.ad) : k.ad;
const trYol = dil === 'en' ? (pathname.replace(/^\/en/, '') || '/') : pathname;
const enYol = dil === 'en' ? pathname : ('/en' + (pathname === '/' ? '/' : pathname));
const anasayfaMi = pathname === '/' || pathname === '/en/';

// Çevirisi olmayan sayfada karşı dilin hreflang'i basılmaz; düğme o dilin köküne gider.
const trAlt = (dil === 'tr' || cevirisiVar) ? SITE.kanonikal + trYol : null;
const enAlt = (dil === 'en' || cevirisiVar) ? SITE.kanonikal + enYol : null;
const trDugme = (dil === 'tr' || cevirisiVar) ? trYol : '/';
const enDugme = (dil === 'en' || cevirisiVar) ? enYol : '/en/';

// Header menüsü içerikten sürülür: menuSira alanı dolu olan sayfalar.
// EN tarafında çevirisi girilmemiş sayfa menüde çıkmaz.
const menu = await menuSayfalari(dil);

const kanonik = SITE.kanonikal + pathname;
const ogGorsel = SITE.kanonikal + (image || '/og-image.jpg');
const anahtarKelimeler = keywords || 'Deltek';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.isim,
  description,
  url: SITE.kanonikal,
  ...(SITE.telefonHam ? { telephone: SITE.telefonHam } : {}),
  ...(SITE.eposta ? { email: SITE.eposta } : {}),
  logo: SITE.kanonikal + '/favicon.svg',
  image: ogGorsel,
  ...(SITE.adres1 ? {
    address: {
      '@type': 'PostalAddress',
      streetAddress: SITE.adres1,
      addressCountry: 'TR',
    },
  } : {}),
};
---
<!doctype html>
<html lang={t.htmlLang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="keywords" content={anahtarKelimeler} />
  <meta name="robots" content="index, follow" />
  <meta name="theme-color" content="#00296b" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="canonical" href={kanonik} />
  {trAlt && <link rel="alternate" hreflang="tr" href={trAlt} />}
  {enAlt && <link rel="alternate" hreflang="en" href={enAlt} />}
  <link rel="alternate" hreflang="x-default" href={trAlt || enAlt} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={SITE.isim} />
  <meta property="og:locale" content={t.ogLocale} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={kanonik} />
  <meta property="og:image" content={ogGorsel} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogGorsel} />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  {sema && <script type="application/ld+json" set:html={JSON.stringify(sema)} />}
</head>
<body class={anasayfaMi ? "anasayfa" : ""}>

<header class="ust" id="ust">
  <div class="kap ust__ic">
    <div class="dil-sec" data-aktif={dil}>
      <span class="dil-sec__knob" aria-hidden="true"></span>
      <a class="dil-sec__b" data-dil="tr" href={trDugme} hreflang="tr" aria-label="Türkçe">TR</a>
      <a class="dil-sec__b" data-dil="en" href={enDugme} hreflang="en" aria-label="English">EN</a>
    </div>
    <a class="logo" href={yol('/')} aria-label={t.aria.home}>
      <img src="/logo-beyaz.svg" alt={SITE.isim} />
    </a>
    <button class="ham" id="ham" aria-label={t.aria.menu} aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
    <nav class="ust__gez" id="gez">
      {KATEGORILER.length > 0 && (
        <span class="dd">
          <a href={yol('/#urunler')} class="dd__t gez2">
            <span>{t.nav.urunler}</span>
            <span class="dd__ok">{t.nav.urunlerAlt}
              <svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true"><path d="M2 3.5 5 6.5 8 3.5" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
            </span>
          </a>
          <div class="dd__p">
            <a href={yol('/#urunler')}><b>{t.nav.tumUrunler}</b></a>
            {KATEGORILER.map(k => <a href={yol(`/kategori/${k.slug}`)}>{kategoriAdi(k)}</a>)}
          </div>
        </span>
      )}
      {menu.map(({ entry, slug }) => (
        <a class="gez2" href={yol(`/${slug}/`)}>
          <span>{(entry.data as any).menuAd || (entry.data as any).baslik}</span><span>&nbsp;</span>
        </a>
      ))}
      <a class="gez2" href={yol('/blog/')}><span>{t.nav.blog[0]}</span><span>&nbsp;</span></a>
      <a class="ust__tel" href={`tel:${SITE.telefonHam}`}>
        <svg viewBox="0 0 16 16" width="13" height="13" fill="currentColor"><path d="M3.6 1.4 5.9 1a.7.7 0 0 1 .78.4l1.06 2.4a.7.7 0 0 1-.2.82l-1.2.98a8.6 8.6 0 0 0 4.06 4.06l.98-1.2a.7.7 0 0 1 .82-.2l2.4 1.06a.7.7 0 0 1 .4.78l-.4 2.3a.7.7 0 0 1-.69.58C6.8 13 3 9.2 3 2.1a.7.7 0 0 1 .6-.7Z"/></svg>
        {SITE.telefon}
      </a>
    </nav>
  </div>
  <!-- kategori ikon şeridi — KATEGORILER boşken hiç render edilmez -->
  {KBAR.length > 0 && (
    <div class="kbar">
      <div class="kap kbar__ic">
        {KBAR.map(k => (
          <a class="kbar__l" href={yol(k.href)}>
            <span class="kbar__i"><img src={k.ikon} alt={kbarAd(k)} data-ikon={k.anahtar} /></span>
            <span class="kbar__t">{kbarAd(k)}</span>
          </a>
        ))}
      </div>
    </div>
  )}
</header>

<main class="icerik">
  <slot />
</main>

<footer class="alt">
  <div class="kap">
    <div class="alt__ic">
      <div>
        <div class="alt__logo"><img src="/logo.svg" alt={SITE.isim}></div>
        {t.footer.slogan && <small>{t.footer.slogan}</small>}
      </div>
      <div>
        <h5>{t.footer.site}</h5>
        <a href={yol('/')}>{t.footer.anasayfa}</a>
        {menu.map(({ entry, slug }) => (
          <a href={yol(`/${slug}/`)}>{(entry.data as any).menuAd || (entry.data as any).baslik}</a>
        ))}
        <a href={yol('/blog/')}>{t.footer.blog}</a>
      </div>
      <div>
        <h5>{t.footer.iletisim}</h5>
        <a class="veri" href={`tel:${SITE.telefonHam}`}>{SITE.telefon}</a>
        <a href={`mailto:${SITE.eposta}`}>{SITE.eposta}</a>
        {SITE.adres1 && <a href="#">{SITE.adres1}<br />{SITE.adres2}</a>}
      </div>
    </div>
    <div class="alt__telif">
      <span>© {new Date().getFullYear()} {SITE.isim}. {t.footer.telif}</span>
      <span>www.deltek.com.tr</span>
    </div>
  </div>
</footer>

<div class="mobil-tel">
  <a class="a" href={`tel:${SITE.telefonHam}`}>{t.mobil.ara}</a>
  {SITE.whatsapp && <a class="b" href={`https://wa.me/${SITE.whatsapp}`}>{t.mobil.wa}</a>}
</div>

{SITE.whatsapp && (
  <a class="wa-fab" href={`https://wa.me/${SITE.whatsapp}?text=${encodeURIComponent(t.waMesaj)}`} target="_blank" rel="noopener" aria-label={t.aria.wa}>
    <svg viewBox="0 0 448 512" fill="currentColor" aria-hidden="true"><path d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.2-157zM223.9 438.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z"/></svg>
  </a>
)}

<style>
/* ─── HEADER ─────────────────────────────────────── */
.icerik { padding-top: var(--baslik-y, 290px); }
@media (max-width: 820px) { .icerik { padding-top: var(--baslik-y, 96px); } }
@media (max-width: 600px) { .icerik { padding-top: var(--baslik-y, 92px); } }
/* ana sayfa hero tam genişlik olduğu için offset'i kendi içinde taşır */
body.anasayfa .icerik { padding-top: 0; }
.dil-sec { position: absolute; top: 16px; right: 6px; width: 77px; height: 25px; background: #fff; border-radius: 999px; z-index: 60; box-shadow: 0 2px 6px -1px rgba(0,0,0,.32); box-sizing: border-box; }
.dil-sec__knob { position: absolute; top: 0; left: 0; width: 43px; height: 25px; background: var(--kirmizi); border-radius: 999px; transition: transform .28s cubic-bezier(.4,.05,.2,1); z-index: 0; pointer-events: none; }
.dil-sec[data-aktif="en"] .dil-sec__knob { transform: translateX(34px); }
.dil-sec__b { position: absolute; top: 50%; transform: translateY(-50%); z-index: 1; font-family: var(--f-dis); font-weight: 800; font-size: .78rem; color: var(--mavi); letter-spacing: .02em; line-height: 1; transition: color .2s ease; }
.dil-sec__b[data-dil="tr"] { left: 13px; }
.dil-sec__b[data-dil="en"] { right: 14px; }
.dil-sec[data-aktif="tr"] .dil-sec__b[data-dil="tr"], .dil-sec[data-aktif="en"] .dil-sec__b[data-dil="en"] { color: #fff; }
@media (max-width: 820px) {
  .dil-sec { top: .7rem; left: .7rem; right: auto; width: auto; height: auto; display: flex; flex-direction: column; gap: 0; border-radius: 13px; }
  .dil-sec__knob { width: 100%; height: 50%; border-radius: 13px; transform: none; }
  .dil-sec[data-aktif="en"] .dil-sec__knob { transform: translateY(100%); }
  .dil-sec__b { position: relative; top: auto; transform: none; flex: 1; text-align: center; font-size: .68rem; padding: .38rem .55rem; letter-spacing: .02em; }
  .dil-sec__b[data-dil="tr"] { left: auto; }
  .dil-sec__b[data-dil="en"] { right: auto; }
}
.ust { position: fixed; inset: 0 0 auto; z-index: 50;
  background: linear-gradient(180deg, var(--mavi-900), var(--mavi-700));
  border-bottom: 1px solid rgba(255,255,255,.1); }
.ust__ic { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: .7rem; padding-block: .85rem; transition: gap .2s, padding .2s; position: relative; }
.logo img { height: 88px; width: auto; transition: height .2s; }
.ust__gez { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 1rem 1.4rem; font-family: var(--f-dis); font-weight: 600; font-size: .92rem; }
.ust__gez a { padding-block: .35rem; border-bottom: 2px solid transparent; color: #fff; }
.ust__gez a:hover { color: var(--sari); border-color: var(--sari); }
/* 2 satırlı menü linkleri (Yatay Sondaj / Makineleri) */
.gez2 { display: inline-flex; flex-direction: column; align-items: center; line-height: 1.12; text-align: center; }
.gez2 > span:first-child { font-weight: 700; }
.gez2 > span:last-child { font-weight: 600; opacity: .92; }
.dd__t.gez2 { flex-direction: column; }
.dd__ok { display: inline-flex; align-items: center; gap: .25rem; font-weight: 600; opacity: .92; }
.dd__ok svg { transition: transform .2s; }
.dd.acik .dd__ok svg { transform: rotate(180deg); }
.ust__tel { display: none; flex-direction: row; align-items: center; gap: .5rem; background: var(--kirmizi); color: #fff; padding: .6rem 1.1rem; border-radius: 999px; font-family: var(--f-dis); font-weight: 700; font-size: .9rem; white-space: nowrap; border-bottom: none !important; box-shadow: 0 9px 18px -5px rgba(0,0,0,.55), 0 4px 7px -2px rgba(0,0,0,.4); }
.ust__tel:hover { background: var(--sari) !important; color: var(--mavi-900) !important; border-color: transparent !important; }
@media (min-width: 980px) { .ust__tel { display: inline-flex; } }

/* ─── HAMBURGER (sadece mobil) ─────────────────── */
.ham { display: none; position: absolute; top: 1rem; right: 1rem; z-index: 70;
  width: 46px; height: 46px; padding: 10px; background: rgba(255,255,255,.12);
  border: 1px solid rgba(255,255,255,.3); border-radius: 6px; cursor: pointer; }
.ham span { display: block; height: 2.5px; background: #fff; border-radius: 2px; margin: 4px 0; transition: transform .25s, opacity .2s; }
.ham[aria-expanded="true"] span:nth-child(1) { transform: translateY(6.5px) rotate(45deg); }
.ham[aria-expanded="true"] span:nth-child(2) { opacity: 0; }
.ham[aria-expanded="true"] span:nth-child(3) { transform: translateY(-6.5px) rotate(-45deg); }
@media (max-width: 979px) {
  .ham { display: block; }
  .ust__ic { flex-direction: row; justify-content: center; position: relative; padding-block: .7rem; }
  .logo img { height: 60px; }
  /* menü varsayılan gizli, hamburger ile açılır */
  .ust__gez { display: none; width: 100%; flex-direction: column; align-items: stretch; gap: 0;
    background: var(--mavi-900); margin-top: .6rem; border-radius: 6px;
    max-height: calc(100vh - 120px); overflow-y: auto; overflow-x: hidden; -webkit-overflow-scrolling: touch; }
  .ust.acik-menu .ust__gez { display: flex; }
  .ust__gez > a, .dd__t { padding: .95rem 1.1rem !important; border-bottom: 1px solid rgba(255,255,255,.12); text-align: left; font-size: 1rem; }
  .ust__gez > a:hover { border-color: rgba(255,255,255,.12); background: rgba(255,255,255,.06); }
  /* mobilde 2 satırlı linkler yan yana tek satır */
  .gez2 { flex-direction: row; align-items: baseline; gap: .35rem; }
  .gez2 > span:last-child:empty, .gez2 > span:last-child:blank { display: none; }
  .dd__t.gez2 { justify-content: space-between; }
  .ust__tel { display: inline-flex !important; margin: .6rem 1.1rem 1rem; justify-content: center; }
  /* mobilde ekipman alt-listesi accordion: dokununca açılır */
  .dd { position: static; }
  .dd__p { display: none !important; position: static !important; width: 100% !important; min-width: 0 !important; max-width: 100% !important; background: var(--mavi-700); border: none; box-shadow: none; padding: 0; margin: 0; transform: none !important; }
  .dd.acik .dd__p { display: block !important; }
  .dd__p a { color: #fff; border-bottom: 1px solid rgba(255,255,255,.1); padding: .8rem 1.6rem; white-space: normal; }
  .dd__p a:hover { background: rgba(255,255,255,.08); color: #fff; }
  .dd__p a b { color: var(--sari); }
  /* ikon şeridi mobilde gizli — menüde zaten var */
  .kbar { display: none; }
}
/* küçülme */
.ust.kuculdu .ust__ic { gap: .3rem; padding-block: .45rem; }
.ust.kuculdu .logo img { height: 50px; }
.ust.kuculdu .ust__gez { font-size: .86rem; }
.ust.kuculdu .kbar { display: none; }

/* ─── KATEGORİ İKON ŞERİDİ ──────────────────────── */
.kbar { background: #fff; border-top: 3px solid var(--sari); }
.kbar__ic { display: flex; justify-content: center; align-items: stretch; gap: .3rem; padding: .55rem 0; }
@media (max-width: 820px) { .kbar__ic { justify-content: flex-start; overflow-x: auto; -webkit-overflow-scrolling: touch; padding-inline: 1rem; } }
.kbar__l { flex: 0 0 auto; display: flex; flex-direction: column; align-items: center; gap: .4rem; width: 132px; padding: .55rem .35rem; border-radius: 5px; color: var(--mavi); text-align: center; transition: transform .15s, background .15s, color .15s; }
.kbar__l:hover { color: var(--mavi-900); background: var(--mavi-050); transform: translateY(-1px); }
.kbar__i { height: 62px; display: grid; place-items: center; }
.kbar__i img { height: 61px; width: auto; filter: invert(22%) sepia(82%) saturate(700%) hue-rotate(195deg) brightness(85%); transition: transform .18s, filter .18s; }
.kbar__l:hover .kbar__i img { transform: scale(1.14); filter: brightness(0) saturate(100%) invert(19%) sepia(89%) saturate(4404%) hue-rotate(327deg) brightness(94%) contrast(94%); }
.kbar__t { font-family: var(--f-metin); font-weight: 600; font-size: .78rem; line-height: 1.2; color: var(--metin); }
.kbar__l:hover .kbar__t { color: var(--mavi-900); }

/* ─── DROPDOWN ───────────────────────────────────── */
.dd { position: relative; }
.dd__t { display: inline-flex; align-items: center; gap: .3rem; cursor: pointer; }
.dd__p { position: absolute; top: calc(100% + .2rem); left: 50%; transform: translateX(-50%); z-index: 60;
  min-width: 270px; background: var(--beyaz); border: 1px solid var(--cizgi); border-top: 3px solid var(--sari);
  box-shadow: 0 20px 40px -22px rgba(0,41,107,.45); padding: .4rem; display: none; text-align: left; }
.dd__p::before { content: ""; position: absolute; top: -.9rem; left: 0; right: 0; height: .9rem; }
.dd:hover .dd__p, .dd:focus-within .dd__p, .dd.acik .dd__p { display: block; }
.dd__p a { display: block; font-family: var(--f-metin); font-weight: 500; font-size: .86rem; color: var(--mavi-900);
  padding: .5rem .7rem; border-bottom: 1px solid var(--kagit-2); white-space: nowrap; }
.dd__p a:last-child { border-bottom: none; }
.dd__p a:hover { background: var(--mavi-050); color: var(--mavi); }
.dd__p a b { color: var(--mavi); }

/* ─── FOOTER ─────────────────────────────────────── */
.alt { background: var(--kagit); border-top: 1px solid var(--cizgi-2); padding-block: 2.5rem 1.5rem; }
.alt__ic { display: grid; gap: 1.5rem; }
@media (min-width: 700px) { .alt__ic { grid-template-columns: 1.5fr 1fr 1fr; } }
.alt__logo img { height: 84px; width: auto; margin-bottom: .9rem; }
.alt small { color: var(--mute); font-size: .8rem; display: block; max-width: 34ch; }
.alt h5 { font-family: var(--f-veri); font-size: .68rem; letter-spacing: .14em; text-transform: uppercase; color: var(--mavi-700); margin-bottom: .8rem; }
.alt a { color: var(--mavi-700); font-size: .88rem; display: block; padding: .25rem 0; }
.alt a:hover { color: var(--mavi); }
.alt__telif { margin-top: 2rem; padding-top: 1.3rem; border-top: 1px solid var(--cizgi); font-family: var(--f-veri); font-size: .7rem; color: var(--mute); display: flex; justify-content: space-between; flex-wrap: wrap; gap: 1rem; }

/* ─── MOBİL SABIT BAR ────────────────────────────── */
.mobil-tel { position: fixed; inset: auto 0 0; z-index: 60; display: flex; gap: .6rem; padding: .7rem;
  background: rgba(255,255,255,.96); border-top: 1px solid var(--cizgi); box-shadow: 0 -8px 24px -16px rgba(0,41,107,.4); }
.mobil-tel a { flex: 1; text-align: center; padding: .85rem; border-radius: 999px; font-family: var(--f-dis); font-weight: 700; font-size: .9rem; box-shadow: 0 9px 18px -5px rgba(0,0,0,.55), 0 4px 7px -2px rgba(0,0,0,.4); }
.wa-fab { position: fixed; right: 22px; bottom: 24px; z-index: 65; width: 60px; height: 60px; border-radius: 50%; background: #00af1c; color: #fff; display: flex; align-items: center; justify-content: center; box-shadow: 0 14px 28px -8px rgba(0,175,28,.6), 0 0 0 0 rgba(0,175,28,.5); animation: wa-pulse 2.4s ease-out infinite; transition: transform .18s ease; }
.wa-fab:hover { transform: scale(1.08); }
.wa-fab svg { width: 32px; height: 32px; }
@keyframes wa-pulse {
  0% { box-shadow: 0 14px 28px -8px rgba(0,175,28,.6), 0 0 0 0 rgba(0,175,28,.5); }
  70% { box-shadow: 0 14px 28px -8px rgba(0,175,28,.6), 0 0 0 16px rgba(0,175,28,0); }
  100% { box-shadow: 0 14px 28px -8px rgba(0,175,28,.6), 0 0 0 0 rgba(0,175,28,0); }
}
@media (prefers-reduced-motion: reduce) { .wa-fab { animation: none; } }
@media (max-width: 980px) { .wa-fab { bottom: 82px; right: 16px; width: 54px; height: 54px; } .wa-fab svg { width: 29px; height: 29px; } }
.mobil-tel .a { background: var(--mavi); color: #fff; }
.mobil-tel .b { border: 1.5px solid var(--mavi); color: var(--mavi-700); }
@media (min-width: 980px) { .mobil-tel { display: none; } }
</style>

<script>
// scroll küçülme
(function() {
  const u = document.getElementById('ust');
  function f() { u?.classList.toggle('kuculdu', window.scrollY > 28); }
  window.addEventListener('scroll', f, { passive: true });
  f();
})();
// header'ın TAM yüksekliğini ölç ve içerik boşluğunu ona göre ayarla
// (ana sayfada da çalışır — hero boşluğu --baslik-y'ye bağlı)
(function() {
  const u = document.getElementById('ust');
  if (!u) return;
  function olc() {
    const kucuk = u.classList.contains('kuculdu');
    if (kucuk) u.classList.remove('kuculdu');   // tam yüksekliği ölçmek için
    const y = u.offsetHeight;
    if (kucuk) u.classList.add('kuculdu');       // eski hâline döndür
    document.documentElement.style.setProperty('--baslik-y', y + 'px');
  }
  olc();
  window.addEventListener('resize', olc, { passive: true });
  window.addEventListener('load', olc);
})();
// hamburger menü aç/kapat (mobil)
(function() {
  const ham = document.getElementById('ham');
  const ust = document.getElementById('ust');
  if (!ham || !ust) return;
  ham.addEventListener('click', () => {
    const acik = ust.classList.toggle('acik-menu');
    ham.setAttribute('aria-expanded', acik ? 'true' : 'false');
  });
  // menüdeki bir bağlantıya tıklayınca menüyü kapat (accordion başlığı hariç)
  ust.querySelectorAll('.ust__gez a:not(.dd__t)').forEach(a => {
    a.addEventListener('click', () => {
      ust.classList.remove('acik-menu');
      ham.setAttribute('aria-expanded', 'false');
    });
  });
})();
// dropdown tıklama
(function() {
  const dds = document.querySelectorAll('.dd');
  dds.forEach(d => {
    const t = d.querySelector('.dd__t');
    if (!t) return;
    t.addEventListener('click', e => {
      e.preventDefault();
      const open = d.classList.contains('acik');
      dds.forEach(x => x.classList.remove('acik'));
      if (!open) d.classList.add('acik');
    });
  });
  document.addEventListener('click', e => {
    if (!(e.target as Element).closest('.dd')) dds.forEach(x => x.classList.remove('acik'));
  });
})();
</script>
<script>
(function(){
  const sec = document.querySelector('.dil-sec');
  if (!sec) return;
  sec.querySelectorAll('.dil-sec__b').forEach(a => {
    a.addEventListener('click', (e) => {
      const yeni = a.getAttribute('data-dil');
      if (sec.getAttribute('data-aktif') === yeni) { e.preventDefault(); return; }
      e.preventDefault();
      sec.setAttribute('data-aktif', yeni);
      const href = a.getAttribute('href');
      const git = window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 0 : 300;
      setTimeout(() => { if (href) window.location.href = href; }, git);
    });
  });
})();
</script>
</body>
</html>
