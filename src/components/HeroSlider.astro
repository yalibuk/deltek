---
/**
 * Ana sayfa hero slider'ı.
 *
 * GÖRSEL KATMANLAR canlı deltek.com.tr'deki Revolution Slider'dan geldiği gibi
 * durur: konum, geçiş tipi (sfl/sfr/sft/sfb/lfl/lfr/lft/lfb), gecikme ve süre
 * orijinaliyle aynı — 2. slaytta sondaj bitinin soldan gelip toprağa girmesi
 * gibi hareketler korunuyor.
 *
 * YAZI ise yeniden tasarlandı: orijinaldeki 2016 tema efektleri (sert çift
 * gölge, renkli kutucuklar, minik puntolar) yerine tek bir tipografik blok.
 * Her slayt kendi `yazi.tema`sına göre koyu ya da açık zemin varyantını,
 * `konum`/`dikey` alanlarına göre de görsel katmanların boş bıraktığı köşeyi
 * kullanır. Metin arkasındaki perde yalnızca metin bloğunun bulunduğu yana
 * uygulanır, fotoğrafın tamamını karartmaz.
 *
 * ÖLÇEKLEME: veri 1920×500 tasarım ızgarasındaki piksellerdir; burada
 * container-query birimiyle (`--olcek`) orantılı ölçeklenir.
 */
import { HERO_IZGARA, type HeroSlayt } from '../data/hero';
import { gorselOznitelik } from '../data/gorselOlcu';

interface Props { slaytlar: HeroSlayt[]; etiket: string; oncekiEtiket: string; sonrakiEtiket: string; }
const { slaytlar, etiket, oncekiEtiket, sonrakiEtiket } = Astro.props;
const { g: IG, y: IY } = HERO_IZGARA;

/**
 * Yazı bloğunun konum/dikey/tema değerleri DOĞRUDAN CSS sınıfına çevriliyor
 * (`yazi--${konum}` …). Geçersiz bir değer TypeScript'te hata verir ama
 * `astro build` tip denetimi YAPMAZ (@astrojs/check kurulu değil), yani
 * sessizce geçer: eşleşen kural bulunamaz, kutu o özelliği hiç almaz.
 *
 * Yaşandı: 'Kullanım alanları' slaytında `konum: 'orta'` yazılmıştı
 * ('orta' `dikey`in değeri,
 * yatayda karşılığı 'merkez'). Sonuç: `yazi--orta` iki kez basıldı, YATAY
 * konum sınıfı (`--sol/--merkez/--sag`) hiç basılmadı; `.yazi` mutlak
 * konumlu ve yatay yerini yalnız o sınıflardan aldığı için blok `left`
 * almadan kaldı, slaytın sol kenarından taşıp ekran dışında kesildi.
 *
 * Bu yüzden değerler derlemede doğrulanıyor — hatayı sayfada değil build'de
 * görmek daha iyi (aynı yaklaşım SayfaBanner ve teknolojiAgaci'nde de var).
 */
const GECERLI: Record<string, readonly string[]> = {
  konum: ['sol', 'merkez', 'sag'],
  dikey: ['ust', 'orta', 'alt'],
  tema: ['koyu', 'acik'],
  eylemKonum: ['akis', 'dip'],
};

slaytlar.forEach((s, i) => {
  for (const [alan, izin] of Object.entries(GECERLI)) {
    const deger = (s.yazi as any)[alan];
    if (deger === undefined) continue;              // isteğe bağlı alan
    if (!izin.includes(deger)) {
      throw new Error(
        `Hero slayt ${i + 1}: "${alan}" değeri geçersiz — "${deger}". ` +
        `Geçerli değerler: ${izin.join(', ')}. ` +
        `(src/data/hero.ts — slayt düzeni tek yerde: HERO_TR. İngilizce sayfa ` +
        `da bu değeri kullanır, en.yazi ayrıca ezmediği sürece.)`);
    }
  }
  // kaydir sayı olmalı: metin verilirse CSS calc() sessizce çöker ve
  // kaydırma hiç uygulanmaz — hatayı build'de görmek daha iyi.
  for (const eksen of ['x', 'y'] as const) {
    const d = s.yazi.kaydir?.[eksen];
    if (d !== undefined && typeof d !== 'number') {
      throw new Error(
        `Hero slayt ${i + 1}: "kaydir.${eksen}" sayı olmalı — "${d}" verilmiş. ` +
        `Birim 1920×500 tasarım ızgarası pikseli, tırnaksız yazın (ör. kaydir: { ${eksen}: -40 }).`);
    }
  }
});

/**
 * `kaydir`ı CSS değişkenine çevirir. Ölçek katmanlarla aynı (`--olcek`),
 * yani değer ekranla orantılı büyüyüp küçülür.
 *
 * `transform` DEĞİL `translate` üretiliyor: `.yazi--orta` dikey ortalama için
 * zaten `transform: translateY(-50%)` kullanıyor, aynı özelliği ikinci kez
 * yazmak onu ezerdi. `translate` ayrı bir özellik olduğu için üstüne biniyor.
 * (Aynı gerekçe yazının giriş animasyonunda da var, bkz. `yazi-gir`.)
 */
const kaydirStil = (k: { x?: number; y?: number } | undefined, yalnizYatay = false) => {
  if (!k) return undefined;
  const p: string[] = [];
  if (k.x) p.push(`--kx:calc(${k.x} * var(--olcek))`);
  if (k.y && !yalnizYatay) p.push(`--ky:calc(${k.y} * var(--olcek))`);
  return p.length ? p.join(';') : undefined;
};

// Görsellerin doğal ölçüsü derlemede dosyadan okunur ve width/height olarak
// basılır: CSS boyutu belirler, öznitelik yalnızca yüklenmeden önce oranı
// verir (CLS). Ölçülemeyen dosyada öznitelik basılmaz.
const olcuBellek = new Map<string, { width?: number; height?: number }>();
for (const s of slaytlar) {
  for (const src of [s.arka, ...s.katmanlar.map(k => k.src)]) {
    if (src && !olcuBellek.has(src)) olcuBellek.set(src, await gorselOznitelik(src));
  }
}
const olcu = (src?: string) => (src && olcuBellek.get(src)) || {};

const katmanStil = (k: any) => [
  `left:${(k.x / IG) * 100}%`,
  `top:${(k.y / IY) * 100}%`,
  `width:${(k.w / IG) * 100}%`,
  // görseller doğal oranıyla akar; video kutusu tabletin ekranına birebir oturmalı
  k.tur === 'video' ? `height:${(k.h / IY) * 100}%` : null,
  `--basla:${k.basla}ms`,
  `--sure:${k.sure}ms`,
].filter(Boolean).join(';');

// Veride satır sonu (\n) varsa gerçek <br> olarak basılır. Ham HTML kabul
// edilmiyor — `<br />` yazmak düz metin olarak görünür, `\n` kullanın.
const satirlaraBol = (m: string) => m.split('\n');
---
<div class="slider" aria-roledescription="carousel" aria-label={etiket}>
  <div class="slider__ray" id="ray">
    {slaytlar.map((s, i) => (
      <div class="slide" data-aktif={i === 0 ? 'true' : 'false'}>
        <img class="slide__arka" src={s.arka} alt={s.alt} {...olcu(s.arka)}
             loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : undefined} decoding="async" />

        {/* metin bloğunun arkasındaki yumuşak perde — yalnızca o yanda */}
        <div class={`perde perde--${s.yazi.konum} perde--${s.yazi.tema}`} aria-hidden="true"></div>

        {s.katmanlar.map(k => (
          k.tur === 'gorsel' ? (
            <img class={`kat kat--${k.gecis}${k.darGizle ? ' kat--darGizle' : ''}`} src={k.src} alt="" aria-hidden="true"
                 {...olcu(k.src)} loading={i === 0 ? 'eager' : 'lazy'} decoding="async" style={katmanStil(k)} />
          ) : (
            <div class={`kat kat--${k.gecis} kat__video`} style={katmanStil(k)}>
              <iframe src={k.video} title={etiket} loading="lazy" allowfullscreen
                allow="accelerometer; clipboard-write; encrypted-media; picture-in-picture"></iframe>
            </div>
          )
        ))}

        <div class={`yazi yazi--${s.yazi.konum} yazi--${s.yazi.dikey} yazi--${s.yazi.tema}`} style={kaydirStil(s.yazi.kaydir)}>
          {s.yazi.ustlik && <p class="yazi__ustlik">{s.yazi.ustlik}</p>}
          <h2 class="yazi__baslik">
            {satirlaraBol(s.yazi.baslik).map((p, k) => (
              <Fragment>{k > 0 && <br />}{p}</Fragment>
            ))}
          </h2>
          {s.yazi.satirlar?.map((satir, j) => (
            <p class="yazi__satir" style={`--sira:${j}`}>
              {satirlaraBol(satir).map((p, k) => (
                <Fragment>{k > 0 && <br />}{p}</Fragment>
              ))}
            </p>
          ))}
          {s.yazi.eylem && s.yazi.eylemKonum !== 'dip' && (
            <a class="yazi__eylem" href={s.yazi.eylemHref ?? '/iletisim/'}>{s.yazi.eylem}</a>
          )}
        </div>

        {/* eylemKonum: 'dip' — buton metin bloğundan koparılıp slaytın
            en altına sabitlenir; yatay hizası yazıyla aynı kalır. */}
        {s.yazi.eylem && s.yazi.eylemKonum === 'dip' && (
          <div class={`yazi yazi--${s.yazi.konum} yazi--dip yazi--${s.yazi.tema}`} style={kaydirStil(s.yazi.kaydir, true)}>
            <a class="yazi__eylem" href={s.yazi.eylemHref ?? '/iletisim/'}>{s.yazi.eylem}</a>
          </div>
        )}
      </div>
    ))}
  </div>
  <button class="ok ok--sol" id="geri" aria-label={oncekiEtiket}>
    <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 3 5 9l6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </button>
  <button class="ok ok--sag" id="ileri" aria-label={sonrakiEtiket}>
    <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 3l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </button>
  <div class="nokta" id="nokta" role="tablist"></div>
</div>

<style>
/* ─── İskelet ─────────────────────────────────────────── */
.slider { position: relative; overflow: hidden; background: var(--kagit-2); container-type: inline-size; }
/* canlı slider'ın tasarım ızgarası 1920×500 — katman konumları buna bağlı */
.slider__ray { display: flex; transition: transform .6s cubic-bezier(.65,0,.35,1); aspect-ratio: 1920/500; }
.slide { position: relative; min-width: 100%; height: 100%; overflow: hidden; }
.slide__arka { width: 100%; height: 100%; object-fit: cover; }

/* ─── Metin perdesi ───────────────────────────────────── */
/* Fotoğrafın tamamını karartmak yerine yalnızca yazının olduğu yanı yumuşatır. */
.perde { position: absolute; inset: 0; z-index: 1; pointer-events: none; }
.perde--koyu.perde--sol { background: linear-gradient(90deg, rgb(var(--blue-900-rgb) / .82) 0%, rgb(var(--blue-900-rgb) / .55) 38%, transparent 68%); }
.perde--koyu.perde--sag { background: linear-gradient(270deg, rgb(var(--blue-900-rgb) / .82) 0%, rgb(var(--blue-900-rgb) / .55) 38%, transparent 68%); }
.perde--acik.perde--sol { background: linear-gradient(90deg, rgb(var(--beyaz-rgb) / .9) 0%, rgb(var(--beyaz-rgb) / .62) 40%, transparent 70%); }
/* Ortalanmış yazı için perde de ortadan dışa doğru açılır. */
.perde--koyu.perde--merkez { background: radial-gradient(58% 78% at 50% 50%, rgb(var(--blue-900-rgb) / .82) 0%, rgb(var(--blue-900-rgb) / .5) 55%, transparent 85%); }
.perde--acik.perde--merkez { background: radial-gradient(58% 78% at 50% 50%, rgb(var(--beyaz-rgb) / .9) 0%, rgb(var(--beyaz-rgb) / .58) 55%, transparent 85%); }
.perde--acik.perde--sag { background: linear-gradient(270deg, rgb(var(--beyaz-rgb) / .9) 0%, rgb(var(--beyaz-rgb) / .62) 40%, transparent 70%); }

/* ─── Görsel katmanlar (canlı slider'daki hâliyle) ────── */
.kat { --olcek: calc(100cqw / 1920); position: absolute; z-index: 2; max-width: none; height: auto;
  opacity: 0; will-change: transform, opacity; }
.kat__video { background: var(--blue-950); }   /* tabletin ekran rengi — video 16:9 olduğu için altta/üstte bant kalır */
/* `darGizle: true` katmanları dar ekranda kaybolur. Yazı kuşağı sabit
   genişlikte (1077px), katmanlar orantılı ölçekli; ekran daraldıkça yazı
   tasarım ızgarasında sağa doğru büyüyor ve sağ kenardaki katmanların
   üstüne çıkıyor. Eşik, sağa hizalı yazının en sağa uzandığı noktaya göre
   seçildi (bkz. hero.ts HeroKatman.darGizle). */
@container (max-width: 1450px) { .kat--darGizle { display: none; } }
.kat__video iframe { width: 100%; height: 100%; border: 0; }

.slide[data-aktif="true"] .kat { animation-duration: var(--sure); animation-delay: var(--basla);
  animation-fill-mode: both; animation-timing-function: cubic-bezier(.25,.46,.45,.94); }
.slide[data-aktif="true"] .kat--sfl { animation-name: kat-sfl; }
.slide[data-aktif="true"] .kat--sfr { animation-name: kat-sfr; }
.slide[data-aktif="true"] .kat--sft { animation-name: kat-sft; }
.slide[data-aktif="true"] .kat--sfb { animation-name: kat-sfb; }
.slide[data-aktif="true"] .kat--lfl { animation-name: kat-lfl; }
.slide[data-aktif="true"] .kat--lfr { animation-name: kat-lfr; }
.slide[data-aktif="true"] .kat--lft { animation-name: kat-lft; }
.slide[data-aktif="true"] .kat--lfb { animation-name: kat-lfb; }
/* yerinde belirir — hareket yok */
.slide[data-aktif="true"] .kat--fade { animation-name: kat-belir; }
@keyframes kat-sfl { from { opacity: 0; transform: translateX(calc(-50 * var(--olcek))); } to { opacity: 1; transform: none; } }
@keyframes kat-sfr { from { opacity: 0; transform: translateX(calc(50 * var(--olcek))); } to { opacity: 1; transform: none; } }
@keyframes kat-sft { from { opacity: 0; transform: translateY(calc(-50 * var(--olcek))); } to { opacity: 1; transform: none; } }
@keyframes kat-sfb { from { opacity: 0; transform: translateY(calc(50 * var(--olcek))); } to { opacity: 1; transform: none; } }
@keyframes kat-lfl { from { opacity: 1; transform: translateX(-100cqw); } to { opacity: 1; transform: none; } }
@keyframes kat-lfr { from { opacity: 1; transform: translateX(100cqw); } to { opacity: 1; transform: none; } }
@keyframes kat-lft { from { opacity: 1; transform: translateY(-100cqh); } to { opacity: 1; transform: none; } }
@keyframes kat-lfb { from { opacity: 1; transform: translateY(100cqh); } to { opacity: 1; transform: none; } }
@keyframes kat-belir { from { opacity: 0; } to { opacity: 1; } }

/* ─── Yazı bloğu ──────────────────────────────────────── */
/* METİN KUŞAĞI — tüm slayt yazıları bu ortalanmış şeridin içinde kalır.
   Şerit, header'daki ana menü satırının (`.ust__gez`, TR menüsünde 797px)
   iki yanına 140'ar piksel eklenerek bulundu: 797 + 2×140 = 1077px.
   Menü sabit genişlikte olduğu için kuşak da sabittir; yalnızca ekran
   daraldığında `.kap` iç payına kadar kısalır. Menü öğeleri değişirse
   `--kusak` yeniden ölçülüp güncellenmeli. */
.yazi { --olcek: calc(100cqw / 1920);
  --kap-pad: clamp(1.15rem, 4vw, 2.75rem);  /* global.css'teki .kap payı */
  --kusak: min(1077px, calc(100cqw - 2 * var(--kap-pad)));
  --kenar: calc((100cqw - var(--kusak)) / 2);
  position: absolute; z-index: 3;
  width: min(calc(700 * var(--olcek)), calc(var(--kusak) * .55));
  /* Slayta ozel ince ayar (hero.ts -> yazi.kaydir). Degiskenler yoksa 0.
     `transform` degil `translate`: .yazi--orta zaten transform kullaniyor. */
  translate: var(--kx, 0) var(--ky, 0); }
.yazi--sol { left: var(--kenar); }
.yazi--sag { right: var(--kenar); text-align: right; }
/* Yatayda ortalanmış blok. `transform` KULLANILMIYOR: dikey ortalama
   (.yazi--orta) zaten translateY uyguluyor, ikisi çakışırdı. Onun yerine
   left/right 0 + margin auto ile ortalanıyor. Değer adı bilerek 'merkez':
   'orta' zaten `dikey` değeri, aynı sınıf adını üretip çakışırdı. */
.yazi--merkez { left: 0; right: 0; margin-inline: auto; text-align: center;
  width: min(calc(1000 * var(--olcek)), var(--kusak)); }
.yazi--merkez .yazi__satir { margin-inline: auto; }
.yazi--orta { top: 50%; transform: translateY(-50%); }
/* butonu taşıyan ikinci blok: slaytın dibine yapışır, genişliği içeriğe göre */
.yazi--dip { top: auto; bottom: calc(26 * var(--olcek)); width: auto; }
.yazi--ust  { top: calc(44 * var(--olcek)); }
.yazi--alt  { bottom: calc(52 * var(--olcek)); }

.yazi__ustlik { font-size: calc(17 * var(--olcek)); font-weight: 700; letter-spacing: .2em;
  text-transform: uppercase; margin-bottom: calc(14 * var(--olcek)); }
.yazi__baslik { font-family: var(--f-dis); font-weight: 800; font-size: calc(52 * var(--olcek));
  line-height: 1.1; letter-spacing: -.015em; text-wrap: balance; }
.yazi__satir { font-size: calc(21 * var(--olcek)); line-height: 1.55;
  margin-top: calc(13 * var(--olcek)); max-width: 52ch; }
.yazi--sag .yazi__satir { margin-left: auto; }
/* Sitedeki `.btn--dolu` ile aynı davranış (bkz. global.css): hover'da
   koyulaşır, 1 px yükselir, gölgesi derinleşir. Ölçüler burada `--olcek`e
   bağlı, çünkü slider tasarım ızgarasıyla birlikte ölçekleniyor. */
.yazi__eylem { display: inline-block; margin-top: calc(20 * var(--olcek));
  font-family: var(--f-dis); font-weight: 700; font-size: calc(19 * var(--olcek));
  padding: calc(15 * var(--olcek)) calc(34 * var(--olcek)); border-radius: 999px;
  transition: background .15s, box-shadow .15s, transform .15s;
  box-shadow: 0 10px 22px -8px rgb(var(--blue-800-rgb) / .45); }
.yazi__eylem:hover { transform: translateY(-1px);
  box-shadow: 0 14px 28px -8px rgb(var(--blue-800-rgb) / .55); }
.yazi__eylem:focus-visible { outline: 3px solid var(--sari); outline-offset: 3px; }

/* koyu fotoğraf üzerinde */
.yazi--koyu .yazi__ustlik { color: var(--sari); }
.yazi--koyu .yazi__baslik { color: var(--beyaz); }
.yazi--koyu .yazi__satir  { color: rgb(var(--beyaz-rgb) / .88); }
.yazi--koyu .yazi__eylem  { background: var(--mavi); color: var(--beyaz); }
/* açık zemin üzerinde */
.yazi--acik .yazi__ustlik { color: var(--vurgu-metin); }
.yazi--acik .yazi__baslik { color: var(--mavi-900); }
/* Fotoğraf üzerinde: --mute açık zeminli slaytta 3.8 kontrasta düşüyordu
   (perde fotoğrafı tam beyazlatmıyor). Koyu palet tonu güvenli. */
.yazi--acik .yazi__satir  { color: var(--blue-800); }
.yazi--acik .yazi__eylem  { background: var(--mavi); color: var(--beyaz); }
/* Hover arka planı BURADA yazılmak zorunda: yukarıdaki tema kuralları
   (`.yazi--koyu .yazi__eylem`) iki sınıflı, dolayısıyla tek sınıflı bir
   `.yazi__eylem:hover` kuralını özgüllükte yener ve renk değişmez. */
.yazi--koyu .yazi__eylem:hover,
.yazi--acik .yazi__eylem:hover { background: var(--mavi-700); }

/* ─── Yazının giriş animasyonu (kademeli) ─────────────── */
/* Her parça bir öncekinden biraz sonra, yukarı doğru yumuşakça belirir. */
.yazi > * { opacity: 0; }
.slide[data-aktif="true"] .yazi > * {
  animation: yazi-gir .72s cubic-bezier(.22,.72,.24,1) both; }
.slide[data-aktif="true"] .yazi__ustlik { animation-delay: .18s; }
.slide[data-aktif="true"] .yazi__baslik { animation-delay: .32s; }
.slide[data-aktif="true"] .yazi__satir  { animation-delay: calc(.48s + var(--sira, 0) * .1s); }
.slide[data-aktif="true"] .yazi__eylem  { animation-delay: .66s; }
/* `transform` DEĞİL `translate` kullanılıyor: animasyon `fill-mode: both` ile
   bittikten sonra da son kareyi tutar, `transform: none` yazsaydı butonun
   hover'daki `translateY(-1px)`ini ezerdi. `translate` ayrı bir özellik,
   `transform` ile çakışmadan üst üste biner. */
@keyframes yazi-gir { from { opacity: 0; translate: 0 calc(26 * var(--olcek)); } to { opacity: 1; translate: 0 0; } }

@media (prefers-reduced-motion: reduce) {
  .slide[data-aktif="true"] .kat,
  .slide[data-aktif="true"] .yazi > * { animation: yazi-belir 1ms both; }
  .slider__ray { transition: none; }
}
@keyframes yazi-belir { from { opacity: 0; } to { opacity: 1; } }

/* ─── Oklar ve noktalar ───────────────────────────────── */
.ok { position: absolute; top: 50%; transform: translateY(-50%); z-index: 5; width: 44px; height: 44px;
  display: grid; place-items: center; background: rgb(var(--beyaz-rgb) / .85); border: 1px solid var(--cizgi-2);
  border-radius: 50%; cursor: pointer; color: var(--mavi-900); transition: .15s; }
.ok:hover { background: var(--mavi); border-color: var(--mavi); color: var(--beyaz); }
.ok--sol { left: .8rem; } .ok--sag { right: .8rem; }
.nokta { position: absolute; left: 0; right: 0; bottom: .9rem; z-index: 6; display: flex; gap: .5rem; justify-content: center; }
.nokta :global(button) { width: 9px; height: 9px; border-radius: 50%; border: none; background: rgb(var(--blue-800-rgb) / .45);
  cursor: pointer; padding: 0; transition: .2s; box-shadow: 0 0 0 1px rgb(var(--beyaz-rgb) / .6); }
.nokta :global(button[aria-current="true"]) { background: var(--mavi); width: 24px; border-radius: 5px; }

/* ─── Dar ekran ───────────────────────────────────────── */
