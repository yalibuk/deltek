---
/**
 * Teknoloji sayfalarının başlık banner'ı.
 *
 * Canlı deltek.com.tr'de her teknoloji sayfasının tepesinde 1170x350'lik bir
 * JPEG duruyordu: SOLDA sayfa başlığı büyük harflerle GÖRSELİN İÇİNE gömülü,
 * SAĞDA konuyu anlatan sembol. Bunun hemen üstünde bir de gerçek <h1> vardı,
 * yani aynı başlık sayfada iki kez görünüyordu — biri de arama motorlarının
 * okuyamadığı piksel hâlinde.
 *
 * Burada başlık metni görselden çıkarıldı (`src/assets/banner/*.webp` yalnız
 * sembolü taşır, bkz. CLAUDE.md → "Banner sembolleri") ve yerine sayfanın
 * TEK <h1>'i konuldu. Böylece tekrar kalktı, başlık metin tabanlı kaldı.
 *
 * Kutunun zemini sembol görselinin zemininin aynısı (--banner-zemin);
 * kesim yerinde dikiş görünmemesi buna bağlı. Görsellerin zemini bilerek
 * DÜZ: gradyanlı olduğunda yalnız görsel kutu kadar yüksekken örtüşüyordu,
 * mobilde sembolün dikdörtgeni leke olarak çıkıyordu.
 *
 * Sembolün genişliği banner yüksekliği × kendi en/boy oranı olarak hesaplanır
 * (--sembol-oran). Böylece görsel hep doğal oranında durur ve yüklenmeden önce
 * de yeri ayrıldığı için sayfa oynamaz (CLS yok).
 */
import type { ImageMetadata } from 'astro';

interface Props {
  baslik: string;
  /** src/assets/banner/<sembol>.webp — uzantısız dosya adı. */
  sembol: string;
  /** Başlığın üstündeki küçük bölüm etiketi (ör. üst dal adı). */
  etiket?: string;
  /**
   * Sembolün alt metni. Sembol konuyu anlatan bir illüstrasyon (dekoratif
   * değil): görsel aramada yakalansın diye başlıktan türetilir, sayfa
   * isterse frontmatter'dan (`bannerAlt`) kendi metnini verir.
   */
  alt?: string;
}
const { baslik, sembol, etiket, alt } = Astro.props;
const sembolAlt = alt || `${baslik} — Deltek kazısız geçiş teknolojisi illüstrasyonu`;

const gorseller = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/banner/*.webp', { eager: true });
const kayit = gorseller[`/src/assets/banner/${sembol}.webp`];
if (!kayit) {
  throw new Error(
    `Banner sembolü yok: src/assets/banner/${sembol}.webp — ` +
    `frontmatter'daki "bannerSembol" değeri dosya adıyla eşleşmeli.`);
}
const g = kayit.default;
const oran = (g.width / g.height).toFixed(4);
---
<div class="sbn" style={`--sembol-oran:${oran}`}>
  <div class="sbn__yazi">
    {etiket && <span class="sbn__etiket">{etiket}</span>}
    <h1 class="sbn__baslik">{baslik}</h1>
  </div>
  {/* Başlık gerçek metin; sembol konuyu anlatan illüstrasyon, alt metni başlıktan türer */}
  <img class="sbn__g" src={g.src} width={g.width} height={g.height}
       alt={sembolAlt} fetchpriority="high" decoding="async" />
</div>

<style>
.sbn {
  /* Yükseklik bilerek düşük: banner sayfanın tepesini yiyordu. 262 -> 197
     (%25). Sembol de aynı oranda küçülüyor çünkü genişliği bu değerden
     türüyor (--sembol-oran) — kırpma yok, ölçek küçülüyor. */
  --sbn-y: clamp(147px, 15.8vw, 197px);
  position: relative;
  display: flex;
  align-items: center;
  min-height: var(--sbn-y);
  background: var(--banner-zemin);
  border: 1px solid var(--cizgi);
  border-radius: 10px;
  overflow: hidden;
  box-shadow: 0 24px 50px -32px rgb(var(--blue-800-rgb) / .5);
  /* Üstte boşluk YOK: banner, yan menü kutusuyla aynı hizada başlamalı.
     Önce iki tarafa da clamp(1.2rem,3vw,2.2rem) veriliyordu ve banner yan
     menüden 35px aşağıda duruyordu. */
  margin-block: 0 clamp(1.2rem, 3vw, 2.2rem);
}
.sbn__yazi {
  flex: 1 1 auto;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: .4rem;
  padding: clamp(1rem, 2.8%, 1.4rem) clamp(1.2rem, 3%, 2rem);
}
.sbn__etiket {
  font-family: var(--f-dis); font-weight: 700; font-size: .72rem;
  letter-spacing: .12em; text-transform: uppercase; color: var(--vurgu-metin);
  line-height: 1.3;   /* gövdeden gelen 1.75 alçalan banner'da yer israfıydı */
}
.sbn__baslik {
  /* Canlı sitede bu başlık görselin içinde ağır ve SIKIŞIK bir grotesk ile
     yazılıydı. Aynı etkiyi aile değiştirmeden veriyoruz: Open Sans değişken
     sürümünün genişlik ekseni (Layout.astro'da wdth 75..100 isteniyor).
     Sıkışık harfler dar olduğu için punto da bir tık büyütüldü. */
  font-family: var(--f-dis); font-weight: 800;
  font-stretch: 75%;
  font-size: clamp(1.5rem, 3.8vw, 2.8rem);
  /* 1.02 denendi: Türkçe büyük harflerde J'nin kuyruğu ile Ç/Ş sedillası ve
     Ğ'nin şapkası alt satıra ve sarı çizgiye giriyordu. 1.14 ikisini de
     kurtarıyor, satır aralığı hâlâ sıkı duruyor. */
  line-height: 1.14; letter-spacing: -.01em;
  text-transform: uppercase; text-wrap: balance;
  color: var(--mavi);
}
/* Sarı çizgi sitenin başlık imzası (bkz. .hsg-ikili__t h3) */
.sbn__baslik::after {
  content: ''; display: block; width: 54px; height: 4px;
  margin-top: .55rem; border-radius: 2px; background: var(--sari);
}
.sbn__g {
  flex: 0 0 auto;
  height: var(--sbn-y);
  /* Doğal oranında: yükseklik × en/boy — hiçbir zaman kırpılmaz.
     max-width metin sütununu ezmesini engeller; oraya dayanan tek sembol
     (boru-yenileme, 1440px'te %49) `contain` ile KÜÇÜLÜR, kırpılmaz.
     Arta kalan yerde banner'ın kendi gradyanı göründüğü için fark edilmez. */
  width: calc(var(--sbn-y) * var(--sembol-oran));
  max-width: 50%;
  object-fit: contain;
  object-position: right center;
  display: block;
}

/* Dar ekran: sembol başlığın altına iner, kendi doğal oranında ortalanır. */
@media (max-width: 719px) {
  .sbn { --sbn-y: 150px; flex-direction: column; align-items: stretch; }
  .sbn__yazi { padding-bottom: .4rem; }
  .sbn__g {
    width: min(100%, calc(var(--sbn-y) * var(--sembol-oran)));
    max-width: 100%;
    height: auto;
    margin-inline: auto;
    object-fit: contain;
  }
}
</style>
